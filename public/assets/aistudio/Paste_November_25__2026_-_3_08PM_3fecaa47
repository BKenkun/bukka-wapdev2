 * POST /api/creator-invitations/send
 * Protegido: requiere token Firebase válido y rol staff (admin o moderator).
 */
app.post('/api/creator-invitations/send', async (req, res) => {
  try {
    const idToken = extractBearerToken(req.headers.authorization);
    if (!idToken) {
      return res.status(401).json({
        success: false,
        sent: false,
        message: 'Se requiere autenticación de Firebase (Authorization: Bearer).'
      });
    }

    const verifiedUser = await verifyFirebaseIdToken(idToken);
    if (!verifiedUser) {
      return res.status(401).json({
        success: false,
        sent: false,
        message: 'Token de Firebase inválido o expirado.'
      });
    }

    const callerRole = await getCallerRoleServer(idToken, verifiedUser);
    if (!callerRole.isStaff) {
      return res.status(403).json({
        success: false,
        sent: false,
        message: 'Acceso denegado: solo el equipo administrador o moderador puede enviar invitaciones.'
      });
    }

    const {
      invitedEmail,
      modelName,
      inviteUrl,
      creatorCommissionPercent = 20,
      wearTeamCommissionPercent,
      webmasterCommissionPercent,
      compensationPhase = 'variable_20_20_60'
    } = req.body || {};

    const cleanEmail = String(invitedEmail || '').trim().toLowerCase();
    const cleanModel = String(modelName || '').trim().slice(0, 100);
    const cleanUrl = String(inviteUrl || '').trim();

    if (!cleanEmail || !cleanEmail.includes('@') || !cleanModel || !/^https?:\/\//i.test(cleanUrl)) {
      return res.status(400).json({
        success: false,
        sent: false,
        message: 'Parámetros de invitación inválidos.'
      });
    }

    if (process.env.MAILJET_API_KEY && process.env.MAILJET_SECRET_KEY) {
      const serverEmailConfig = await readServerEmailConfig().catch(() => DEFAULT_SITE_CONFIG.email);
      const mjRes = await sendCreatorInvitationEmail({
        invitedEmail: cleanEmail,
        modelName: cleanModel,
        inviteUrl: cleanUrl,
        creatorCommissionPercent: Number(creatorCommissionPercent) || 20,
        wearTeamCommissionPercent:
          typeof wearTeamCommissionPercent === 'number' ? wearTeamCommissionPercent : undefined,
        webmasterCommissionPercent:
          typeof webmasterCommissionPercent === 'number' ? webmasterCommissionPercent : undefined,
        compensationPhase: String(compensationPhase || 'variable_20_20_60'),
        emailConfig: serverEmailConfig
      });
      return res.json({
        success: true,
        sent: mjRes.success,
        simulated: mjRes.simulated,
        inviteUrl: cleanUrl,
        message: mjRes.success
          ? `Invitación enviada por email a ${cleanEmail}.`
          : mjRes.error || 'Enlace generado listo para copiar.'
      });
    }

    console.log(`[Creator Invite Sandbox] Enlace generado para ${cleanModel} (${cleanEmail}): ${cleanUrl}`);
    return res.json({
      success: true,
      sent: false,
      simulated: true,
      inviteUrl: cleanUrl,
      message: 'Invitación registrada en Firestore. Copia el enlace seguro para enviárselo a la creadora.'
    });
  } catch (err: any) {
    console.error('[Creator Invite] Error:', err);
    return res.status(500).json({
      success: false,
      sent: false,
      message: err?.message || 'Error procesando invitación de creadora.'
    });
  }
});

