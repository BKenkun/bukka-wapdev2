    configured: Boolean(process.env.HILOW_WEBHOOK_SECRET && process.env.HILOW_API_KEY),
    endpoint: '/api/webhooks/hilow'
  });
});

/**
 * 2b. Endpoint Webhook de Confirmación de Pago (HMAC-SHA256 + Firestore + Packlink)
 * POST /api/webhooks/hilow
 */
app.post('/api/webhooks/hilow', async (req: any, res) => {
  const webhookSecret = process.env.HILOW_WEBHOOK_SECRET?.trim() || DEV_EPHEMERAL_WEBHOOK_SECRET;
  const signature = String(
    req.headers['hilow-signature'] || req.headers['x-hilow-signature'] || ''
  ).trim();
  const rawBody = req.rawBody || JSON.stringify(req.body || {});

  if (!webhookSecret) {
    console.error('[HILOW WEBHOOK] HILOW_WEBHOOK_SECRET no está configurado.');
    return res.status(500).json({ error: 'Webhook no configurado' });
  }

  if (!signature) {
    console.error('[HILOW WEBHOOK] Falta firma.');
    return res.status(401).json({ error: 'Firma ausente' });
  }

  try {
    const expectedSignature = crypto.createHmac('sha256', webhookSecret).update(rawBody).digest('hex');

    if (!safeSignatureEqual(signature, expectedSignature)) {
      console.error('[HILOW WEBHOOK] Firma inválida.');
      return res.status(403).json({ error: 'Firma inválida' });
    }

    const payload = (
      typeof req.body === 'object' && req.body !== null ? req.body : JSON.parse(rawBody)
    ) as Record<string, any>;

    const eventType = getEventType(payload);
    const internalOrderId = String(payload.internalOrderId || payload.orderId || '').trim();
    const hilowOrderId = payload.hilowOrderId || payload.paymentId || payload.id || null;
    const amountInCents = parseAmountInCents(payload);

    if (!internalOrderId || !/^[a-zA-Z0-9_-]{3,128}$/.test(internalOrderId)) {
      return res.status(400).json({ error: 'internalOrderId no válido' });
    }

    if (!eventType) {
      return res.status(400).json({ error: 'eventType no válido' });
    }

    const { prefix, isSubscription, userId, orderDocId } = parseInternalOrderId(internalOrderId);

    console.log('[HILOW WEBHOOK] Evento recibido', {
      eventType,
      internalOrderId,
      userId,
      orderDocId,
      hilowOrderId,
      amountInCents
    });

    // Registro de auditoría no bloqueante en /webhookEvents
    const safePayload = JSON.parse(JSON.stringify(payload));
    await runWithAdminFirestore(
      (adminDb) =>
        adminDb
          .collection('webhookEvents')
          .doc(`${internalOrderId}_${Date.now()}`)
          .set({
            provider: 'hilow',
            eventType,
            internalOrderId,
            hilowOrderId,
            amountInCents,
            receivedAt: new Date().toISOString(),
            payload: safePayload
          }),
      'hilow-webhook-audit'
    ).catch((auditErr) => {
      console.warn(
        '[HILOW WEBHOOK] Auditoría omitida:',
        auditErr instanceof Error ? auditErr.message : String(auditErr)
      );
    });

    if (isPaymentCompleted(eventType)) {
      const dbResult = await runWithAdminFirestore(async (adminFirestore) => {
        const orderRef = adminFirestore.collection('orders').doc(orderDocId);
        let orderSnap = await orderRef.get();

        // Respaldo: buscar por campo id o por segmento BOX-... si el ID del documento difiere del internalOrderId
        let resolvedOrderRef = orderRef;
        if (!orderSnap.exists) {
          const fallbackQuery = await adminFirestore
            .collection('orders')
            .where('id', '==', orderDocId)
            .limit(1)
            .get();
          if (!fallbackQuery.empty) {
            orderSnap = fallbackQuery.docs[0];
            resolvedOrderRef = fallbackQuery.docs[0].ref;
          } else if (isSubscription) {
            const subParts = internalOrderId.split('_');
            const shortBoxId = subParts.length >= 4 ? subParts[subParts.length - 2] : '';
            if (shortBoxId) {
              const boxSnap = await adminFirestore.collection('orders').doc(shortBoxId).get();
              if (boxSnap.exists) {
                orderSnap = boxSnap;
                resolvedOrderRef = boxSnap.ref;
              }
            }
          }
        }

        const existingOrder = orderSnap.exists ? (orderSnap.data() as Record<string, any>) : null;
        const resolvedUserId = String(existingOrder?.userId || userId || 'guest');

        // Validación de importe (1 céntimo de tolerancia; en Chloe's Secrets total está en Euros)
        if (orderSnap.exists && payload.amountInCents !== undefined && payload.amountInCents !== null) {
          const receivedCents = Math.round(Number(payload.amountInCents));
          const expectedCents = Math.round((Number(existingOrder?.total) || 0) * 100);
          if (
            Number.isFinite(receivedCents) &&
            receivedCents > 0 &&
            Number.isFinite(expectedCents) &&
            expectedCents > 0 &&
            Math.abs(receivedCents - expectedCents) > 1
          ) {
            console.error('[HILOW WEBHOOK] Importe no coincide con el pedido:', {
              internalOrderId,
              receivedCents,
              expectedCents
            });
            return { kind: 'amount_mismatch' as const };
          }
        }

        // Idempotencia: evita repetir puntos/correos si el webhook ya se procesó
        const paidStatuses = ['paid', 'order_received', 'processing', 'shipped', 'delivered'];
        if (existingOrder?.status && paidStatuses.includes(String(existingOrder.status))) {
          return { kind: 'already_paid' as const, existingStatus: String(existingOrder.status), finalOrder: existingOrder };
        }

        const nowIso = new Date().toISOString();
        const orderData: Record<string, any> = {
          status: 'paid',
          paidAt: nowIso,
          hilowPaymentId: hilowOrderId || undefined,
          updatedAt: nowIso
        };

        // Si el documento no existía (falló el guardado previo), reconstruirlo para no perder el cobro
        if (!orderSnap.exists) {
          const fallbackTotalEur = Number(((amountInCents || 0) / 100).toFixed(2));
          orderData.id = orderDocId;
          orderData.userId = resolvedUserId === 'guest' ? null : resolvedUserId;
          orderData.isGuest = resolvedUserId === 'guest';
          orderData.customerEmail = payload.email || payload.customerEmail || 'cliente@chloesecrets.com';
          orderData.customerName = payload.customerName || payload.name || 'Cliente VIP';
          orderData.subtotal = fallbackTotalEur;
          orderData.discount = 0;
          orderData.shipping = 0;
          orderData.total = fallbackTotalEur;
          orderData.paymentMethod = 'hilow';
          orderData.reconstructedFromWebhook = true;
          orderData.createdAt = nowIso;
          orderData.shippingAddress = {
            street: payload.address || 'Dirección pendiente de confirmar',
            city: payload.city || '-',
            state: payload.state || '-',
            postalCode: payload.postalCode || '00000',
            country: payload.country || 'España',
            phone: payload.phone || '-'
          };
          orderData.items = [
            {
              productId: 'paid_order',
              productName: String(payload.productName || payload.description || "Pedido Chloe's Secrets World"),
              price: fallbackTotalEur,
              quantity: 1,
              color: 'Estándar',
              size: 'Única',
              image: ''
            }
          ];
        }

        await resolvedOrderRef.set(orderData, { merge: true });

        // Puntos de fidelidad VIP (1 punto por cada Euro)
        const orderTotalEur = Number(existingOrder?.total ?? orderData.total ?? 0);
        const points = Math.max(
          1,
          Math.floor(amountInCents ? amountInCents / 100 : orderTotalEur)
        );
        if (points > 0 && resolvedUserId && resolvedUserId !== 'guest') {
          const userRef = adminFirestore.collection('users').doc(resolvedUserId);
          await userRef.set(
            {
              loyaltyPoints: FieldValue.increment(points),
              ...(isSubscription
                ? {
                    isSubscribed: true,
                    subscriptionStatus: 'active',
                    lastSubscriptionPayment: nowIso
                  }
                : {}),
              updatedAt: nowIso
            },
            { merge: true }
          );
        }

        // Aplicar cooldown post-venta automático (oculto/re-stock de artículos vendidos)
        if (!isSubscription && Array.isArray(existingOrder?.items)) {
          for (const soldItem of existingOrder.items) {
            const prodId = String(soldItem?.productId || '').trim();
            if (!prodId || prodId === 'paid_order' || prodId === 'subscription_club') continue;
            try {
              const prodRef = adminFirestore.collection('products').doc(prodId);
              const prodSnap = await prodRef.get();
              const cooldownDays =
                prodSnap.exists && typeof prodSnap.data()?.cooldownDays === 'number'
                  ? Math.max(1, Math.min(30, Number(prodSnap.data()?.cooldownDays)))
                  : 4;
              const cooldownUntil = new Date(
                Date.now() + cooldownDays * 24 * 60 * 60 * 1000
              ).toISOString();
              await prodRef.set(
                {
                  availabilityStatus: 'cooldown',
                  inStock: false,
                  cooldownUntil,
                  lastSoldAt: nowIso,
                  updatedAt: nowIso
                },
                { merge: true }
              );
            } catch (cdErr) {
              console.warn(`[HILOW WEBHOOK] Cooldown update skipped for ${prodId}:`, cdErr);
            }
          }
        }

        const finalSnap = await resolvedOrderRef.get();
        return {
          kind: 'updated' as const,
          finalOrder: finalSnap.exists ? ({ ...finalSnap.data(), id: orderDocId } as Record<string, any>) : null
        };
      }, 'hilow-webhook-payment-completed');

      if (dbResult.available && dbResult.result.kind === 'amount_mismatch') {
        return res.status(400).json({ error: 'Importe del pago no coincide' });
      }

      const existingOrFallbackOrder =
        dbResult.available && dbResult.result.finalOrder ? dbResult.result.finalOrder : null;

      if (dbResult.available && dbResult.result.kind === 'already_paid') {
        verifiedPayments.set(internalOrderId, {
          status: 'paid',
          hilowOrderId: typeof hilowOrderId === 'string' ? hilowOrderId : undefined,
          amountInCents,
          customerName: existingOrFallbackOrder?.customerName,
          customerEmail: existingOrFallbackOrder?.customerEmail,
          total: existingOrFallbackOrder?.total,
          verifiedAt: new Date().toISOString()
        });
        return res.status(200).json({ received: true, processed: 'already_paid' });
      }

      // Guardar en caché en memoria del servidor para confirmación instantánea de polling
      if (verifiedPayments.size > 1000) {
        const oldestKey = verifiedPayments.keys().next().value;
        if (oldestKey) verifiedPayments.delete(oldestKey);
      }
      verifiedPayments.set(internalOrderId, {
        status: 'paid',
        hilowOrderId: typeof hilowOrderId === 'string' ? hilowOrderId : undefined,
        amountInCents,
        customerName: existingOrFallbackOrder?.customerName || payload.customerName || payload.name,
        customerEmail: existingOrFallbackOrder?.customerEmail || payload.email || payload.customerEmail,
        total:
          existingOrFallbackOrder?.total ??
          (amountInCents ? Number((amountInCents / 100).toFixed(2)) : undefined),
        verifiedAt: new Date().toISOString()
      });

      const finalOrder =
        dbResult.available && dbResult.result.finalOrder
          ? dbResult.result.finalOrder
          : {
              id: orderDocId,
              userId: userId || 'guest',
              isGuest: userId === 'guest',
              customerName: payload.customerName || payload.name || 'Cliente VIP',
              customerEmail: payload.email || payload.customerEmail || '',
              total: (amountInCents || 0) / 100
            };

      // Sincronizar envío Packlink (si aplica y autoCreateShipmentOnPaid está activo) y adjuntar PDF de etiqueta / hoja discreta al email del administrador
      let syncedPacklinkMeta = finalOrder.packlink;
      if (!isSubscription && (prefix === 'CS' || prefix === 'CPO')) {
        const plCfg = await readPacklinkSettings().catch(() => null);
        if (!plCfg || plCfg.autoCreateShipmentOnPaid !== false) {
          syncedPacklinkMeta = await syncOrderPacklinkShipment(finalOrder, {
            docPath: `orders/${orderDocId}`
          }).catch(() => finalOrder.packlink);
          if (syncedPacklinkMeta) {
            finalOrder.packlink = syncedPacklinkMeta;
          }
        }
      }

      const adminShippingAttachments =
        !isSubscription
          ? await buildAdminShippingEmailAttachments(finalOrder).catch(() => [])
          : [];

      // Tareas secundarias no bloqueantes (correo Mailjet o respaldo SMTP + auditoría de log)
      const tasks: Promise<unknown>[] = [];
      const serverEmailConfig = await readServerEmailConfig().catch(() => DEFAULT_SITE_CONFIG.email);
      if (process.env.MAILJET_API_KEY && process.env.MAILJET_SECRET_KEY) {
        const mailjetOrder = toMailjetOrder(finalOrder);
        tasks.push(sendOrderReceivedEmail(mailjetOrder, serverEmailConfig));
        tasks.push(sendAdminNewOrderEmail(mailjetOrder, adminShippingAttachments, serverEmailConfig));
        if (isSubscription) {
          tasks.push(sendSubscriptionStatusEmail(mailjetOrder, 'active', serverEmailConfig));
        }
      } else {
        tasks.push(sendServerPaymentEmail(finalOrder, serverEmailConfig));
      }
      if (finalOrder?.customerEmail) {
        const logId = `log_webhook_${orderDocId}_${Date.now()}`;
        const emailSentViaGateway = Boolean(
          (process.env.MAILJET_API_KEY && process.env.MAILJET_SECRET_KEY) ||
          (process.env.SMTP_HOST && process.env.SMTP_USER && process.env.SMTP_PASS)
        );
        tasks.push(
          runWithAdminFirestore(
            (adminDb) =>
              adminDb.collection('email_logs').doc(logId).set({
                id: logId,
                orderId: orderDocId,
                to: String(finalOrder.customerEmail),
                recipientName: String(finalOrder.customerName || 'Cliente VIP'),
                subject: `Confirmación oficial · Pedido #${orderDocId}`,
                status: emailSentViaGateway ? 'sent' : 'pending',
                timestamp: new Date().toISOString(),
                source: process.env.MAILJET_API_KEY ? 'mailjet_webhook' : 'smtp_webhook'
              }),
            'webhook-email-log'
          ).catch(() => undefined)
        );
      }
      await Promise.allSettled(tasks);

      return res.status(200).json({ received: true, processed: 'payment_completed', orderId: orderDocId });
    }

    if (isPaymentFailed(eventType)) {
      verifiedPayments.set(internalOrderId, {
        status: 'issue',
        hilowOrderId: typeof hilowOrderId === 'string' ? hilowOrderId : undefined,
        amountInCents,
        verifiedAt: new Date().toISOString()
      });

      await runWithAdminFirestore(async (adminFirestore) => {
        const nowIso = new Date().toISOString();
        const orderRef = adminFirestore.collection('orders').doc(orderDocId);
        await orderRef.set(
          {
            status: 'issue',
            paymentFailureAt: nowIso,
            updatedAt: nowIso
          },
          { merge: true }
        );
        if (isSubscription && userId !== 'guest') {
          await adminFirestore
            .collection('users')
            .doc(userId)
            .set({ subscriptionStatus: 'past_due', updatedAt: nowIso }, { merge: true });
        }
      }, 'hilow-webhook-payment-failed');

      if (
        isSubscription &&
        process.env.MAILJET_API_KEY &&
        process.env.MAILJET_SECRET_KEY &&
        (payload.email || payload.customerEmail)
      ) {
        const fallbackSub = amountInCents
          ? { amountInCents }
          : await getAuthoritativeSubscriptionConfig();
        const serverEmailConfig = await readServerEmailConfig().catch(() => DEFAULT_SITE_CONFIG.email);
        await sendSubscriptionStatusEmail(
          toMailjetOrder({
            id: orderDocId,
            userId,
            customerName: payload.customerName || payload.name || 'Cliente',
            customerEmail: payload.email || payload.customerEmail,
            total: (amountInCents || fallbackSub.amountInCents) / 100
          }),
          'past_due',
          serverEmailConfig
        ).catch(() => undefined);
      }

      return res.status(200).json({ received: true, processed: 'payment_failed' });
    }

    if (isSubscriptionCancelled(eventType)) {
      await runWithAdminFirestore(async (adminFirestore) => {
        if (userId !== 'guest') {
          await adminFirestore
            .collection('users')
            .doc(userId)
            .set(
              {
                isSubscribed: false,
                subscriptionStatus: 'cancelled',
                updatedAt: new Date().toISOString()
              },
              { merge: true }
            );
        }
      }, 'hilow-webhook-subscription-cancelled');

      if (
        process.env.MAILJET_API_KEY &&
        process.env.MAILJET_SECRET_KEY &&
        (payload.email || payload.customerEmail)
      ) {
        const fallbackSub = amountInCents
          ? { amountInCents }
          : await getAuthoritativeSubscriptionConfig();
        const serverEmailConfig = await readServerEmailConfig().catch(() => DEFAULT_SITE_CONFIG.email);
        await sendSubscriptionStatusEmail(
          toMailjetOrder({
            id: orderDocId,
            userId,
            customerName: payload.customerName || payload.name || 'Cliente',
            customerEmail: payload.email || payload.customerEmail,
            total: (amountInCents || fallbackSub.amountInCents) / 100
          }),
          'cancelled',
          serverEmailConfig
        ).catch(() => undefined);
      }

      return res.status(200).json({ received: true, processed: 'subscription_cancelled' });
    }

    console.warn('[HILOW WEBHOOK] Evento no mapeado:', eventType);
    return res.status(200).json({ received: true, processed: 'ignored_event', eventType });
  } catch (error: any) {
    const isAuthError = isAdminCredentialError(error);
    console.error('[HILOW WEBHOOK] Error crítico:', {
      category: isAuthError ? 'firebase_admin_credentials_invalid_or_revoked' : 'unexpected_runtime_error',
      code: error?.code,
      message: error?.message || String(error)
    });
    return res.status(500).json({ error: 'Internal Server Error' });
  }
});

async function createOrderViaUserRest(
  orderPayload: Record<string, any>,
  userId: string,
  orderDocId: string,
  idToken: string
): Promise<{ success: boolean; error?: string }> {
  try {
    const decoded = await verifyFirebaseIdToken(idToken);
    if (!decoded || decoded.uid !== userId) {
      return { success: false, error: 'La sesión del usuario no coincide con el pedido.' };
    }

    const now = new Date();
    const docFields: Record<string, unknown> = {};
    const bodyObject: Record<string, unknown> = {
      ...orderPayload,
      id: orderDocId,
      userId,
      isGuest: false,
      createdAt: now.toISOString(),
      updatedAt: now.toISOString()
    };

    for (const [key, val] of Object.entries(bodyObject)) {
      if (val !== undefined) {
        docFields[key] = toFirestoreRestValue(val);
      }
    }

    const url = `https://firestore.googleapis.com/v1/projects/${encodeURIComponent(
      projectId
    )}/databases/${encodeURIComponent(databaseId)}/documents/orders/${encodeURIComponent(
      orderDocId
    )}`;

    const res = await fetch(url, {
      method: 'PATCH',
      headers: {
        Authorization: `Bearer ${idToken}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ fields: docFields })
    });

    if (!res.ok) {
      const errText = await res.text().catch(() => '');
      return {
        success: false,
        error: errText || 'No se pudo registrar el pedido con tu sesión de usuario.'
      };
    }

    return { success: true };
  } catch (err) {
    return {
      success: false,
      error: err instanceof Error ? err.message : 'Error guardando el pedido con token de usuario.'
    };
  }
}

async function createCheckoutOrderServer(
  data: Record<string, any> & { idToken?: string }
): Promise<{ success: boolean; error?: string }> {
  const { idToken, ...orderFields } = data;
  const orderDocId = String(orderFields.id || orderFields.orderId || '').trim();
  const rawUid = orderFields.userId;
  const userId = rawUid && rawUid !== 'guest' ? String(rawUid) : 'guest';

  if (!orderDocId || !/^[a-zA-Z0-9_-]{3,128}$/.test(orderDocId)) {
    return { success: false, error: 'Identificador de pedido inválido.' };
  }

  let credentialBlocked = !areAdminCredentialsAvailable();

  if (!credentialBlocked) {
    try {
      const adminRes = await runWithAdminFirestore(async (adminDb) => {
        const nowIso = new Date().toISOString();
        await adminDb
          .collection('orders')
          .doc(orderDocId)
          .set(
            {
              ...orderFields,
              id: orderDocId,
              userId: userId === 'guest' ? null : userId,
              isGuest: userId === 'guest',
              createdAt: orderFields.createdAt || nowIso,
              updatedAt: nowIso
            },
            { merge: true }
          );

        const promoCode = String(
          orderFields.promoCodeApplied || orderFields.coupon?.code || ''
        )
          .trim()
          .toUpperCase();
        if (promoCode) {
          try {
            const promoSnap = await adminDb
              .collection('promoCodes')
              .where('code', '==', promoCode)
              .limit(1)
              .get();
            if (!promoSnap.empty) {
              await promoSnap.docs[0].ref.update({
                usesCount: FieldValue.increment(1),
                updatedAt: nowIso
              });
            }
          } catch (promoErr) {
            console.info(
              '[createCheckoutOrder] No se pudo incrementar usesCount del cupón:',
              promoErr instanceof Error ? promoErr.message : String(promoErr)
            );
          }
        }
      }, 'checkout createOrder');

      if (adminRes.available) {
        return { success: true };
      }
      credentialBlocked = true;
    } catch (error) {
      if (isAdminCredentialError(error)) {
        credentialBlocked = true;
      } else {
        console.error(
          '[createCheckoutOrder] Error creating order in Firestore:',
          error instanceof Error ? error.message : String(error)
        );
        return {
          success: false,
          error: error instanceof Error ? error.message : 'Error al guardar el pedido en Firestore.'
        };
      }
    }
  }

  if (credentialBlocked && userId !== 'guest' && idToken) {
    return createOrderViaUserRest(orderFields, userId, orderDocId, idToken);
  }

  return {
    success: false,
    error: 'Credenciales de servidor de Firebase Admin no activas en este entorno.'
  };
}

async function getCheckoutOrderStatusServer(orderId: string): Promise<{
  exists: boolean;
  status?: string;
  total?: number;
  isGuest?: boolean;
  customerName?: string;
  customerEmail?: string;
}> {
  if (!areAdminCredentialsAvailable()) {
    return { exists: false };
  }

  try {
    const res = await runWithAdminFirestore(async (adminDb) => {
      const snap = await adminDb.collection('orders').doc(orderId).get();
      if (snap.exists) {
        const d = snap.data();
        return {
          exists: true,
          status: d?.status,
          total: d?.total,
          isGuest: d?.isGuest ?? !d?.userId,
          customerName: d?.customerName,
          customerEmail: d?.customerEmail
        };
      }
      const querySnap = await adminDb
        .collection('orders')
        .where('id', '==', orderId)
        .limit(1)
        .get();
      if (!querySnap.empty) {
        const d = querySnap.docs[0].data();
        return {
          exists: true,
          status: d?.status,
          total: d?.total,
          isGuest: d?.isGuest ?? !d?.userId,
          customerName: d?.customerName,
          customerEmail: d?.customerEmail
        };
      }
      return { exists: false };
    }, 'checkout getOrderStatus');

    return res.available ? res.result : { exists: false };
  } catch (error) {
    if (!isAdminCredentialError(error)) {
      console.info(
        '[getCheckoutOrderStatus] Error checking order status:',
        error instanceof Error ? error.message : String(error)
      );
    }
    return { exists: false };
  }
}

/**
 * 2c. Registro / Sincronización de pedido en servidor y actualización de uso de cupones
 * POST /api/checkout/create-order
 */
app.post('/api/checkout/create-order', async (req, res) => {
  try {
    const payload = { ...(req.body || {}) };
    const authHeader = String(req.headers.authorization || '');
    const bearerToken = authHeader.startsWith('Bearer ') ? authHeader.slice(7).trim() : undefined;

    const orderDocId = String(payload.id || payload.orderId || '');
    const isSubscriptionOrder = orderDocId.startsWith('SUB_');

    if (!isSubscriptionOrder && Array.isArray(payload.items) && payload.items.length > 0) {
      try {
        const computed = await calculateServerOrderTotals({
          items: payload.items,
          promoCode: payload.promoCodeApplied || payload.coupon?.code,
          shippingAddress: payload.shippingAddress,
          selectedServiceId: payload.packlink?.serviceId
        });
        payload.items = computed.items;
        payload.subtotal = computed.subtotal;
        payload.volumeDiscount = computed.volumeDiscount;
        payload.discount = computed.discount;
        payload.shipping = computed.shipping;
        payload.total = computed.total;
        if (computed.appliedPromoCode) {
          payload.promoCodeApplied = computed.appliedPromoCode;
        } else {
          delete payload.promoCodeApplied;
        }
      } catch (pricingErr) {
        if (pricingErr instanceof CheckoutPricingError) {
          return res.status(pricingErr.statusCode).json({
            success: false,
            message: pricingErr.message
          });
        }
      }
    }

    const result = await createCheckoutOrderServer({
      ...payload,
      idToken: payload.idToken || bearerToken
    });

    if (!result.success) {
      return res.status(202).json({
        success: false,
        deferredToClient: true,
        message: result.error
      });
    }

    return res.json({ success: true });
  } catch (err: any) {
    return res.status(500).json({
      success: false,
      message: err?.message || 'Error guardando pedido en el servidor.'
    });
  }
});

