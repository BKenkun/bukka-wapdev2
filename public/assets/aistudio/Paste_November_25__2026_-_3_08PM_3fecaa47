function sanitizeGatewayErrorMessage(error: unknown): string {
  const rawMessage = error instanceof Error ? error.message : 'No se pudo iniciar el pago.';
  return rawMessage.replace(/hilow(\s*global)?/gi, 'la pasarela de pago');
}

function decodeFirestoreRestField(field: any): any {
  if (!field || typeof field !== 'object') return undefined;
  if ('nullValue' in field) return null;
  if ('booleanValue' in field) return Boolean(field.booleanValue);
  if ('integerValue' in field) return Number(field.integerValue);
  if ('doubleValue' in field) return Number(field.doubleValue);
  if ('timestampValue' in field) return String(field.timestampValue);
  if ('stringValue' in field) return String(field.stringValue);
  if ('arrayValue' in field) {
    return Array.isArray(field.arrayValue?.values)
      ? field.arrayValue.values.map((v: any) => decodeFirestoreRestField(v))
      : [];
  }
  if ('mapValue' in field) {
    const out: Record<string, any> = {};
    for (const [k, v] of Object.entries(field.mapValue?.fields || {})) {
      const val = decodeFirestoreRestField(v);
      if (val !== undefined) out[k] = val;
    }
    return out;
  }
  return undefined;
}

async function readServerEmailConfig(): Promise<EmailConfig> {
  const fallback = DEFAULT_SITE_CONFIG.email;
  try {
    const adminRes = await runWithAdminFirestore(async (adminDb) => {
      const snap = await adminDb.collection('appSettings').doc('site').get();
      return snap.exists ? (snap.data()?.siteConfig?.email as Partial<EmailConfig> | undefined) : undefined;
    }, 'read-server-email-config');

    let remoteEmail: Partial<EmailConfig> | undefined = adminRes.available ? adminRes.result : undefined;

    if (!adminRes.available) {
      const restUrl = `https://firestore.googleapis.com/v1/projects/${encodeURIComponent(
        projectId
      )}/databases/${encodeURIComponent(databaseId)}/documents/appSettings/site`;
      const resp = await fetch(restUrl).catch(() => null);
      if (resp && resp.ok) {
        const json: any = await resp.json().catch(() => null);
        const siteCfg = decodeFirestoreRestField(json?.fields?.siteConfig);
        remoteEmail = siteCfg?.email;
      }
    }

    if (!remoteEmail) return fallback;
    return {
      ...fallback,
      ...remoteEmail,
      templates: {
        auth: { ...fallback.templates.auth, ...(remoteEmail.templates?.auth || {}) },
        orders: { ...fallback.templates.orders, ...(remoteEmail.templates?.orders || {}) },
        subscriptions: {
          ...fallback.templates.subscriptions,
          ...(remoteEmail.templates?.subscriptions || {})
        },
        creators: { ...fallback.templates.creators, ...(remoteEmail.templates?.creators || {}) }
      }
    };
  } catch {
    return fallback;
  }
}

interface CreateHilowApiOrderParams {
  yourInternalOrderId: string;
  amountInCents: number;
  productName: string;
  isSubscription: boolean;
  yourStoreUrl: string;
  storeDomain?: string;
  successUrl?: string;
  cancelUrl?: string;
}

/**
 * Crea un pedido a través del endpoint de API seguro de Hilow Global
 * siguiendo la estructura probada de createHilowApiOrder.
 */
async function createHilowApiOrder({
  yourInternalOrderId,
  amountInCents,
  productName,
  isSubscription,
  yourStoreUrl,
  storeDomain,
  successUrl,
  cancelUrl
}: CreateHilowApiOrderParams): Promise<{
  success: boolean;
  checkoutUrl?: string;
  hilowOrderId?: string;
  order?: Record<string, unknown>;
  message?: string;
  statusCode?: number;
}> {
  try {
    const cleanBaseUrl = yourStoreUrl.replace(/\/+$/, '');
    const parsedUrl = new URL(cleanBaseUrl);
    const preferredStoreId = (
      storeDomain ||
      process.env.HILOW_STORE_ID ||
      process.env.HILOW_STORE_DOMAIN ||
      parsedUrl.hostname
    ).trim();

    const hilowApiBaseUrl = (process.env.HILOW_API_BASE_URL || 'https://hilowglobal.com').replace(
      /\/+$/,
      ''
    );
    const hilowPayOrigin = (process.env.HILOW_PAY_ORIGIN || 'https://hilowglobal.com').replace(
      /\/+$/,
      ''
    );
    const HILOW_API_ENDPOINT = `${hilowApiBaseUrl}/api/orders`;
    const HILOW_API_KEY = process.env.HILOW_API_KEY?.trim();

    if (!HILOW_API_KEY) {
      return {
        success: false,
        statusCode: 503,
        message: 'La pasarela de pago no está disponible temporalmente.'
      };
    }

    const normalizedAmount = Math.round(Number(amountInCents));
    if (!Number.isFinite(normalizedAmount) || normalizedAmount <= 0) {
      return {
        success: false,
        statusCode: 400,
        message: 'El importe del pedido no es válido.'
      };
    }

    const sendCreateOrder = async (candidateStoreId: string) => {
      const candidatePayload = {
        storeId: candidateStoreId,
        internalOrderId: yourInternalOrderId,
        amountInCents: normalizedAmount,
        productName: productName || "Chloe's Secrets World - Compra",
        isSubscription: Boolean(isSubscription),
        successUrl:
          successUrl ||
          `${cleanBaseUrl}/checkout/success?order_id=${encodeURIComponent(yourInternalOrderId)}`,
        cancelUrl: cancelUrl || `${cleanBaseUrl}/products`
      };

      const resp = await fetch(HILOW_API_ENDPOINT, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${HILOW_API_KEY}`
        },
        body: JSON.stringify(candidatePayload)
      });
      const data: any = await resp.json().catch(() => ({}));
      return { resp, data, payload: candidatePayload };
    };

    let attempt = await sendCreateOrder(preferredStoreId);

    // If ephemeral Cloud Run/preview hostname is rejected as Unauthorized domain, use registered preview domain
    const errMsgLower = String(attempt.data?.message || attempt.data?.error || '').toLowerCase();
    if (
      !attempt.resp.ok &&
      !storeDomain &&
      !process.env.HILOW_STORE_ID &&
      !process.env.HILOW_STORE_DOMAIN &&
      preferredStoreId !== 'chloesecrets.ai.studio' &&
      (errMsgLower.includes('unauthorized domain') || attempt.resp.status === 403)
    ) {
      attempt = await sendCreateOrder('chloesecrets.ai.studio');
    }

    const { resp: response, data: responseData, payload } = attempt;

    if (!response.ok) {
      throw new Error(
        responseData?.message ||
          responseData?.error ||
          `Error en la pasarela de pago (${response.status}).`
      );
    }

    const resolvedHilowOrderId =
      responseData?.hilowOrderId || responseData?.id || responseData?.orderId || '';

    if (resolvedHilowOrderId) {
      const checkoutUrl = `${hilowPayOrigin}/pay/${resolvedHilowOrderId}`;
      return {
        success: true,
        checkoutUrl,
        hilowOrderId: resolvedHilowOrderId,
        order: payload
      };
    }

    if (
      typeof responseData?.checkoutUrl === 'string' &&
      responseData.checkoutUrl.startsWith('https://')
    ) {
      return {
        success: true,
        checkoutUrl: responseData.checkoutUrl,
        order: payload
      };
    }

    throw new Error('Respuesta no válida de la pasarela de pago.');
  } catch (error) {
    console.error('[PAYMENT] Gateway error:', error instanceof Error ? error.message : String(error));
    return {
      success: false,
      statusCode: 502,
      message: sanitizeGatewayErrorMessage(error)
    };
  }
}

function sanitizeRedirectUrl(
  rawUrl: unknown,
  allowedBaseUrl: string,
  fallbackUrl: string
): string {
  if (typeof rawUrl !== 'string' || !rawUrl.trim()) return fallbackUrl;
  const trimmed = rawUrl.trim();
  if (trimmed.startsWith('/')) {
    return `${allowedBaseUrl.replace(/\/+$/, '')}${trimmed}`;
  }
  try {
    const candidate = new URL(trimmed);
    const base = new URL(allowedBaseUrl);
    if (
      (candidate.protocol === 'https:' || candidate.protocol === 'http:') &&
      candidate.origin === base.origin
    ) {
      return candidate.toString();
    }
  } catch {
    // Fall back to safe origin URL
  }
  return fallbackUrl;
}

/**
 * 1. Endpoint Server-to-Server para Crear Pedido en la Pasarela de Pago
 * POST /api/hilow/create-order
 */
app.post('/api/hilow/create-order', async (req, res) => {
  try {
    const {
      internalOrderId,
      productName,
      isSubscription = false,
      storeUrl,
      successUrl,
      cancelUrl,
      storeDomain,
      items,
      promoCode,
      shippingAddress,
      selectedServiceId
    } = req.body || {};

    if (
      typeof internalOrderId !== 'string' ||
      !/^[a-zA-Z0-9_-]{3,128}$/.test(internalOrderId.trim())
    ) {
      return res.status(400).json({
        success: false,
        message: 'Faltan parámetros obligatorios o el identificador de pedido no es válido.'
      });
    }

    const cleanInternalOrderId = internalOrderId.trim();
    const isSub = Boolean(isSubscription);

    let authoritativeAmountInCents: number;
    let authoritativeProductName: string;
    let computedSummary: Awaited<ReturnType<typeof calculateServerOrderTotals>> | null = null;

    if (isSub) {
      // Suscripción mensual con tarifa autoritativa configurada desde Admin (appSettings/site)
      const subConfig = await getAuthoritativeSubscriptionConfig();
      authoritativeAmountInCents = subConfig.amountInCents;
      authoritativeProductName = subConfig.planName;
    } else {
      if (!Array.isArray(items) || items.length === 0) {
        return res.status(400).json({
          success: false,
          message: 'Debes incluir los artículos del carrito para calcular el importe verificado en el servidor.'
        });
      }

      try {
        computedSummary = await calculateServerOrderTotals({
          items,
          promoCode: typeof promoCode === 'string' ? promoCode : undefined,
          shippingAddress:
            shippingAddress && typeof shippingAddress === 'object' ? shippingAddress : undefined,
          selectedServiceId: typeof selectedServiceId === 'string' ? selectedServiceId : undefined
        });
      } catch (pricingErr) {
        if (pricingErr instanceof CheckoutPricingError) {
          return res.status(pricingErr.statusCode).json({
            success: false,
            message: pricingErr.message,
            error: pricingErr.message
          });
        }
        throw pricingErr;
      }

      authoritativeAmountInCents = computedSummary.amountInCents;
      const fallbackProductSummary =
        computedSummary.items
          .map((i) => `${i.quantity}x ${i.productName}`)
          .join(', ')
          .slice(0, 120) || "Chloe's Secrets World - Compra";
      authoritativeProductName =
        typeof productName === 'string' && productName.trim()
          ? productName.trim().slice(0, 120)
          : fallbackProductSummary;

      // Si el pedido ya existe en Firestore con Admin SDK activo, sincronizar totales verificados
      await runWithAdminFirestore(async (adminDb) => {
        const orderRef = adminDb.collection('orders').doc(cleanInternalOrderId);
        const existingSnap = await orderRef.get();
        if (existingSnap.exists) {
          await orderRef.set(
            {
              items: computedSummary!.items,
              subtotal: computedSummary!.subtotal,
              volumeDiscount: computedSummary!.volumeDiscount,
              discount: computedSummary!.discount,
              shipping: computedSummary!.shipping,
              total: computedSummary!.total,
              ...(computedSummary!.appliedPromoCode
                ? { promoCodeApplied: computedSummary!.appliedPromoCode }
                : {}),
              updatedAt: new Date().toISOString()
            },
            { merge: true }
          );
        }
      }, 'hilow-reconcile-order-totals').catch(() => undefined);
    }

    const forwardedProto = String(req.headers['x-forwarded-proto'] || req.protocol || 'https')
      .split(',')[0]
      .trim();
    const hostHeader = req.get('host');
    const inferredOrigin = hostHeader ? `${forwardedProto}://${hostHeader}` : '';
    const yourStoreUrl = String(process.env.APP_URL || inferredOrigin || storeUrl).trim();

    if (!yourStoreUrl || !/^https?:\/\//i.test(yourStoreUrl)) {
      return res.status(400).json({
        success: false,
        message: 'No se pudo determinar la URL base de la tienda para iniciar el pago.'
      });
    }

    const baseClean = yourStoreUrl.replace(/\/+$/, '');
    const defaultSuccess = `${baseClean}/checkout/success?order_id=${encodeURIComponent(cleanInternalOrderId)}`;
    const defaultCancel = `${baseClean}/products`;

    const result = await createHilowApiOrder({
      yourInternalOrderId: cleanInternalOrderId,
      amountInCents: authoritativeAmountInCents,
      productName: authoritativeProductName,
      isSubscription: isSub,
      yourStoreUrl: baseClean,
      storeDomain: typeof storeDomain === 'string' ? storeDomain : undefined,
      successUrl: sanitizeRedirectUrl(successUrl, baseClean, defaultSuccess),
      cancelUrl: sanitizeRedirectUrl(cancelUrl, baseClean, defaultCancel)
    });

    if (!result.success || !result.checkoutUrl) {
      return res.status(result.statusCode || 502).json({
        success: false,
        message: result.message || 'No se pudo iniciar el pago.',
        error: result.message || 'No se pudo iniciar el pago.'
      });
    }

    return res.json({
      success: true,
      checkoutUrl: result.checkoutUrl,
      paymentUrl: result.checkoutUrl,
      hilowOrderId: result.hilowOrderId,
      isSimulation: false,
      order: result.order,
      ...(computedSummary
        ? {
            pricing: {
              items: computedSummary.items,
              subtotal: computedSummary.subtotal,
              volumeDiscount: computedSummary.volumeDiscount,
              discount: computedSummary.discount,
              shipping: computedSummary.shipping,
              total: computedSummary.total,
              amountInCents: computedSummary.amountInCents,
              ...(computedSummary.appliedPromoCode
                ? { appliedPromoCode: computedSummary.appliedPromoCode }
                : {}),
              ...(computedSummary.verifiedQuote
                ? { verifiedQuote: computedSummary.verifiedQuote }
                : {})
            }
          }
        : {})
    });
  } catch (error) {
    console.error('[PAYMENT] Server error creating order:', error instanceof Error ? error.message : String(error));
    const message = sanitizeGatewayErrorMessage(error);
    return res.status(500).json({ success: false, message, error: message });
  }
});

function normalizeSignature(value: string) {
  return value.trim().replace(/^sha256=/i, '').trim();
}

function safeSignatureEqual(received: string, expected: string) {
  const a = Buffer.from(normalizeSignature(received), 'utf8');
  const b = Buffer.from(expected, 'utf8');
  return a.length === b.length && crypto.timingSafeEqual(a, b);
}

function getEventType(payload: Record<string, any>) {
  const explicit = String(payload.eventType || payload.event || payload.type || '')
    .toLowerCase()
    .trim();
  if (explicit) return explicit;
  const fallbackStatus = String(payload.status || '').toLowerCase().trim();
  if (['completed', 'paid', 'succeeded', 'success'].includes(fallbackStatus)) {
    return 'payment.completed';
  }
  if (['failed', 'failure', 'error'].includes(fallbackStatus)) {
    return 'payment.failed';
  }
  return '';
}

function isPaymentCompleted(eventType: string) {
  return [
    'payment.completed',
    'payment.succeeded',
    'payment.success',
    'payment.renewal_succeeded',
    'payment.renewed'
  ].includes(eventType);
}

function isPaymentFailed(eventType: string) {
  return ['payment.failed', 'payment.failure', 'payment.error'].includes(eventType);
}

function isSubscriptionCancelled(eventType: string) {
  return ['subscription.cancelled', 'subscription.canceled'].includes(eventType);
}

function parseAmountInCents(payload: Record<string, any>): number {
  if (payload.amountInCents !== undefined && payload.amountInCents !== null) {
    const val = Number(payload.amountInCents);
    return Number.isFinite(val) ? Math.round(val) : 0;
  }
  if (payload.amount !== undefined && payload.amount !== null) {
    const val = Number(payload.amount);
    if (!Number.isFinite(val)) return 0;
    return Number.isInteger(val) ? val : Math.round(val * 100);
  }
  return 0;
}

function parseInternalOrderId(internalOrderId: string) {
  const parts = internalOrderId.split('_');
  const prefix = parts[0] || '';
  const isSubscription = prefix === 'SUB';

  let userId = 'guest';
  let orderDocId = internalOrderId;

  if (isSubscription) {
    if (parts.length >= 4) {
      // SUB_<userId>_<uniqueOrderId>_<timestamp>
      userId = parts.slice(1, parts.length - 2).join('_') || 'guest';
      orderDocId = internalOrderId;
    } else if (parts.length === 3) {
      // SUB_<userId>_<timestamp>
      userId = parts[1] || 'guest';
      orderDocId = internalOrderId;
    }
  } else if ((prefix === 'CS' || prefix === 'CPO') && parts.length >= 3) {
    userId = parts.slice(1, -1).join('_') || 'guest';
    orderDocId = internalOrderId;
  }

  return { prefix, isSubscription, userId, orderDocId };
}

// Logística Packlink PRO y generación de PDFs gestionada en ./src/server/shippingPdf.ts

function buildSmtpTransportConfig(emailConfig?: EmailConfig) {
  const smtpHost = process.env.SMTP_HOST?.trim();
  const smtpAccount = process.env.SMTP_USER?.trim();
  const smtpSecret = process.env.SMTP_PASS?.trim();
  if (!smtpHost || !smtpAccount || !smtpSecret) return null;

  const smtpPort = Number(process.env.SMTP_PORT) || 465;
  const senderDisplay = (emailConfig?.senderName || "Chloe's Secrets World").replace(/"/g, '');
  const senderMailbox =
    emailConfig?.senderEmail?.trim() || DEFAULT_SITE_CONFIG.email.replyToEmail;
  const fromHeader = process.env.EMAIL_FROM || `"${senderDisplay}" <${senderMailbox}>`;

  return {
    smtpHost,
    smtpAccount,
    smtpSecret,
    smtpPort,
    fromHeader
  };
}

async function sendServerPaymentEmail(
  order: Record<string, any>,
  emailConfig?: EmailConfig
) {
  if (!order.customerEmail) {
    return { skipped: true, reason: 'Recipient email missing' };
  }

  const smtpConfig = buildSmtpTransportConfig(emailConfig);
  if (!smtpConfig) {
    return { skipped: true, reason: 'SMTP not configured' };
  }

  const nodemailer = (await import('nodemailer')).default;
  const transporter = nodemailer.createTransport({
    host: smtpConfig.smtpHost,
    port: smtpConfig.smtpPort,
    secure: smtpConfig.smtpPort === 465,
    auth: {
      user: smtpConfig.smtpAccount,
      pass: smtpConfig.smtpSecret
    }
  });

  const rawItems = Array.isArray(order.items) ? order.items : [];
  const totalEur = Number(order.total || 0);
  const shippingEur = Number(order.shipping ?? order.shippingCost ?? 0);
  const subjectTpl =
    emailConfig?.templates?.orders?.orderConfirmation?.subject ||
    "Confirmación de tu pedido #{orderId} - Chloe's Secrets World";

  const html = renderOrderConfirmationEmailHtml(
    {
      id: String(order.id || ''),
      userId: String(order.userId || 'guest'),
      customerName: String(order.customerName || 'Cliente'),
      customerEmail: String(order.customerEmail),
      items: rawItems.map((it: Record<string, any>) => ({
        productId: String(it.productId || 'item'),
        productName: String(it.productName || it.name || 'Prenda Exclusiva'),
        price: Number(it.price || 0),
        quantity: Number(it.quantity || 1),
        size: String(it.size || 'Única'),
        color: String(it.color || 'Estándar'),
        image: String(it.image || it.imageUrl || '')
      })),
      subtotal: Math.max(0, totalEur - shippingEur),
      discount: Number(order.discount || 0),
      shipping: shippingEur,
      total: totalEur,
      shippingAddress: {
        street: String(order.shippingAddress?.street || order.shippingAddress?.line1 || 'Dirección registrada'),
        city: String(order.shippingAddress?.city || ''),
        postalCode: String(order.shippingAddress?.postalCode || order.shippingAddress?.postal_code || ''),
        country: String(order.shippingAddress?.country || 'España'),
        phone: String(order.shippingAddress?.phone || '')
      },
      status: 'paid',
      createdAt: String(order.createdAt || new Date().toISOString())
    },
    { emailConfig }
  );

  const info = await transporter.sendMail({
    from: smtpConfig.fromHeader,
    to: order.customerEmail,
    replyTo: emailConfig?.replyToEmail || undefined,
    subject: subjectTpl.replaceAll('{orderId}', String(order.id || '')),
    html
  });

  return { success: true, messageId: info.messageId };
}

function toMailjetOrder(rawOrder: Record<string, any>): MailjetOrder {
  const rawItems = Array.isArray(rawOrder.items) ? rawOrder.items : [];
  const addr = rawOrder.shippingAddress || {};
  const totalEur = Number(rawOrder.total) || 0;
  const shippingEur = Number(rawOrder.shipping ?? rawOrder.shippingCost) || 0;

  return {
    id: String(rawOrder.id || 'UNKNOWN'),
    userId: String(rawOrder.userId || 'guest'),
    createdAt: rawOrder.createdAt ? new Date(rawOrder.createdAt) : new Date(),
    status: 'order_received',
    total: Math.round(totalEur * 100),
    shippingCost: Math.round(shippingEur * 100),
    shippingFree: Boolean(rawOrder.shippingFree ?? shippingEur === 0),
    items: rawItems.map((item: Record<string, any>) => ({
      productId: String(item.productId || 'item'),
      name: String(item.productName || item.name || 'Producto'),
      price: Math.round((Number(item.price) || 0) * 100),
      quantity: Number(item.quantity) || 1,
      imageUrl: String(item.image || item.imageUrl || 'https://chloesecrets.com/placeholder.jpg')
    })),
    customerName: String(rawOrder.customerName || 'Cliente'),
    customerEmail: String(rawOrder.customerEmail || ''),
    shippingAddress: {
      line1: addr.street || addr.line1 || null,
      line2: addr.line2 || null,
      city: addr.city || null,
      state: addr.state || null,
      postal_code: addr.postalCode || addr.postal_code || null,
      country: addr.country || null,
      phone: addr.phone || null
    },
    paymentMethod: 'hilow',
    path: rawOrder.path || `orders/${String(rawOrder.id || 'UNKNOWN')}`,
    packlink: rawOrder.packlink
  };
}

