/**
 * 2e. Consulta de estado verificado (Webhook caché + Firestore Admin)
 * GET /api/checkout/order-status/:orderId
 * GET /api/checkout/order-status?orderId=...
 * GET /api/hilow/order-status/:internalOrderId
 */
const orderStatusHandler = async (req: express.Request, res: express.Response) => {
  const orderId = String(
    req.params.orderId || req.params.internalOrderId || req.query.orderId || ''
  ).trim();
  if (!orderId || !/^[a-zA-Z0-9_-]{3,128}$/.test(orderId)) {
    return res.status(400).json({ success: false, paid: false, message: 'ID de pedido inválido.' });
  }

  const record = verifiedPayments.get(orderId);
  if (record?.status === 'paid' || record?.status === 'order_received') {
    return res.json({
      success: true,
      exists: true,
      paid: true,
      status: record.status,
      total: record.total,
      customerName: record.customerName,
      customerEmail: record.customerEmail,
      orderId,
      verifiedAt: record.verifiedAt
    });
  }

  if (record?.status === 'issue') {
    return res.json({
      success: true,
      exists: true,
      paid: false,
      failed: true,
      status: 'issue',
      orderId,
      verifiedAt: record.verifiedAt
    });
  }

  const dbStatus = await getCheckoutOrderStatusServer(orderId);
  if (dbStatus.exists) {
    const isPaid = ['paid', 'order_received', 'processing', 'shipped', 'delivered'].includes(
      String(dbStatus.status || '')
    );
    return res.json({
      success: true,
      exists: true,
      paid: isPaid,
      failed: dbStatus.status === 'issue',
      status: dbStatus.status || 'pending_payment',
      total: dbStatus.total,
      isGuest: dbStatus.isGuest,
      customerName: dbStatus.customerName,
      customerEmail: dbStatus.customerEmail,
      orderId
    });
  }

  return res.json({
    success: true,
    exists: false,
    paid: false,
    status: 'pending_payment',
    orderId
  });
};

app.get('/api/hilow/order-status/:internalOrderId', orderStatusHandler);
app.get('/api/checkout/order-status/:orderId', orderStatusHandler);
