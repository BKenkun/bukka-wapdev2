  if (process.env.NODE_ENV === 'production') {
    return res.status(404).json({ success: false, message: 'No disponible en producción.' });
  }

  try {
    const { internalOrderId, amountInCents } = req.body || {};
    if (typeof internalOrderId !== 'string' || !internalOrderId.trim()) {
      return res.status(400).json({ success: false, message: 'Falta internalOrderId.' });
