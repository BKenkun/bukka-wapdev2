      return res.status(401).json({ success: false, error: 'Se requiere autenticación de Firebase.' });
    }

    const verifiedUser = await verifyFirebaseIdToken(idToken);
    if (!verifiedUser) {
      return res.status(401).json({ success: false, error: 'Token de Firebase inválido o expirado.' });
    }

    const callerRole = await getCallerRoleServer(idToken, verifiedUser);
    if (!callerRole.isStaff) {
      return res.status(403).json({ success: false, error: 'Solo el equipo administrador puede gestionar etiquetas Packlink.' });
    }

    const orderId = String(req.params.orderId || '').trim();
