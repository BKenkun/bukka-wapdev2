    const payload = {
      internalOrderId: internalOrderId.trim(),
      amountInCents: Number(amountInCents) || 7999,
      status: 'completed',
      timestamp: new Date().toISOString()
    };

    const signature = crypto
      .createHmac('sha256', webhookSecret)
      .update(JSON.stringify(payload))
      .digest('hex');

