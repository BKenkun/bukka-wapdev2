const authEmailRateLimiter = new Map<string, { count: number; resetAt: number }>();

function checkAuthEmailRateLimit(key: string, maxRequests = 6, windowMs = 10 * 60 * 1000): boolean {
  const now = Date.now();
  const entry = authEmailRateLimiter.get(key);
  if (!entry || entry.resetAt <= now) {
    authEmailRateLimiter.set(key, { count: 1, resetAt: now + windowMs });
    return true;
  }
  if (entry.count >= maxRequests) return false;
  entry.count += 1;
  return true;
}

function resolveSafeContinueUrl(rawOrigin?: unknown): string {
  const fallback = (
    process.env.APP_BASE_URL ||
    process.env.APP_URL ||
    process.env.VITE_APP_URL ||
    'https://chloesecrets.com'
  )
    .trim()
    .replace(/\/$/, '');

  if (typeof rawOrigin !== 'string' || !rawOrigin.trim()) return fallback;
  try {
    const parsed = new URL(rawOrigin.trim());
    if (
      parsed.protocol === 'https:' ||
      (parsed.protocol === 'http:' && (parsed.hostname === 'localhost' || parsed.hostname === '127.0.0.1'))
    ) {
      return parsed.origin;
    }
  } catch {
    // Fallback to configured origin
  }
  return fallback;
}

/**
 * 4a-ter. Correos transaccionales de Firebase Auth (verificación, bienvenida y cambio de contraseña) vía Mailjet
 * POST /api/auth/dispatch-lifecycle-emails
 */
app.post('/api/auth/dispatch-lifecycle-emails', async (req, res) => {
  try {
    const idToken = extractBearerToken(req.headers.authorization);
    if (!idToken) {
      return res.status(401).json({ success: false, error: 'Se requiere autenticación.' });
    }
    const verifiedUser = await verifyFirebaseIdToken(idToken);
    if (!verifiedUser || !verifiedUser.email) {
      return res.status(401).json({ success: false, error: 'Token inválido o usuario sin correo.' });
    }

    const rateKey = `lifecycle:${verifiedUser.uid}`;
    if (!checkAuthEmailRateLimit(rateKey, 8, 10 * 60 * 1000)) {
      return res.status(429).json({
        success: false,
        error: 'Has solicitado varios envíos seguidos. Espera unos minutos e inténtalo de nuevo.'
      });
    }

    const { sendVerification, sendWelcome, sendPasswordChanged, origin, recipientName } = req.body || {};
    const mailjetConfigured = Boolean(
      process.env.MAILJET_API_KEY?.trim() && process.env.MAILJET_SECRET_KEY?.trim()
    );
    const serverEmailConfig = await readServerEmailConfig().catch(() => DEFAULT_SITE_CONFIG.email);
    const continueUrl = resolveSafeContinueUrl(origin);
    const displayName = String(recipientName || verifiedUser.email.split('@')[0] || 'Miembro VIP').trim();

    let verificationMode: 'mailjet' | 'fallback_client' | 'disabled' | 'already_verified' | 'skipped' = 'skipped';
    let welcomeSent = false;
    let passwordChangedSent = false;

    if (sendVerification) {
      if (verifiedUser.emailVerified) {
        verificationMode = 'already_verified';
      } else if (serverEmailConfig.templates?.auth?.verifyEmail?.enabled === false) {
        verificationMode = 'disabled';
      } else if (!mailjetConfigured) {
        verificationMode = 'fallback_client';
      } else {
        const adminAuth = getAdminAuth();
        if (!adminAuth) {
          verificationMode = 'fallback_client';
        } else {
          try {
            const verificationLink = await adminAuth.generateEmailVerificationLink(
              verifiedUser.email,
              { url: continueUrl }
            );
            const mjVerify = await sendAuthTransactionalEmail({
              type: 'verifyEmail',
              toEmail: verifiedUser.email,
              recipientName: displayName,
              actionUrl: verificationLink,
              emailConfig: serverEmailConfig
            });
            verificationMode = mjVerify.success ? 'mailjet' : 'fallback_client';

            if (mjVerify.success) {
              const logId = `log_auth_verify_${verifiedUser.uid.slice(0, 12)}_${Date.now()}`;
              await runWithAdminFirestore(
                (adminDb) =>
                  adminDb.collection('email_logs').doc(logId).set({
                    id: logId,
                    orderId: `AUTH_${verifiedUser.uid.slice(0, 10)}`,
                    to: verifiedUser.email,
                    recipientName: displayName,
                    subject:
                      serverEmailConfig.templates?.auth?.verifyEmail?.subject ||
                      'Verificación de correo electrónico',
                    status: 'sent',
                    timestamp: new Date().toISOString(),
                    source: 'mailjet_auth'
                  }),
                'log-auth-verify-email'
              ).catch(() => undefined);
            }
          } catch (err) {
            if (!isAdminCredentialError(err)) {
              console.warn('[Auth Mailjet] No se pudo generar enlace de verificación:', err);
            }
            verificationMode = 'fallback_client';
          }
        }
      }
    }

    if (sendWelcome && mailjetConfigured && serverEmailConfig.templates?.auth?.welcome?.enabled !== false) {
      const mjWelcome = await sendAuthTransactionalEmail({
        type: 'welcome',
        toEmail: verifiedUser.email,
        recipientName: displayName,
        actionUrl: continueUrl,
        emailConfig: serverEmailConfig
      });
      welcomeSent = mjWelcome.success;
      if (mjWelcome.success) {
        const logId = `log_auth_welcome_${verifiedUser.uid.slice(0, 12)}_${Date.now()}`;
        await runWithAdminFirestore(
          (adminDb) =>
            adminDb.collection('email_logs').doc(logId).set({
              id: logId,
              orderId: `WELCOME_${verifiedUser.uid.slice(0, 10)}`,
              to: verifiedUser.email,
              recipientName: displayName,
              subject:
                serverEmailConfig.templates?.auth?.welcome?.subject ||
                "Bienvenida al Club Privado de Chloe's Secrets",
              status: 'sent',
              timestamp: new Date().toISOString(),
              source: 'mailjet_auth'
            }),
          'log-auth-welcome-email'
        ).catch(() => undefined);
      }
    }

    if (
      sendPasswordChanged &&
      mailjetConfigured &&
      serverEmailConfig.templates?.auth?.passwordChanged?.enabled !== false
    ) {
      const mjPwd = await sendAuthTransactionalEmail({
        type: 'passwordChanged',
        toEmail: verifiedUser.email,
        recipientName: displayName,
        actionUrl: continueUrl,
        emailConfig: serverEmailConfig
      });
      passwordChangedSent = mjPwd.success;
    }

    return res.json({
      success: true,
      verificationMode,
      fallbackVerificationToClient: verificationMode === 'fallback_client',
      welcomeSent,
      passwordChangedSent
    });
  } catch (err: any) {
    return res.status(500).json({
      success: false,
      fallbackVerificationToClient: true,
      error: err?.message || 'Error despachando correos de cuenta.'
    });
  }
});

/**
 * 4a-quater. Recuperación de contraseña con plantilla de lujo vía Mailjet + Action Link oficial de Firebase
 * POST /api/auth/send-password-reset
 */
app.post('/api/auth/send-password-reset', async (req, res) => {
  try {
    const cleanEmail = String(req.body?.email || '').trim().toLowerCase();
    if (!cleanEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(cleanEmail)) {
      return res.status(400).json({ success: false, error: 'Introduce un correo electrónico válido.' });
    }

    const clientIp = req.ip || 'unknown';
    if (
      !checkAuthEmailRateLimit(`reset:ip:${clientIp}`, 10, 15 * 60 * 1000) ||
      !checkAuthEmailRateLimit(`reset:email:${cleanEmail}`, 5, 15 * 60 * 1000)
    ) {
      return res.status(429).json({
        success: false,
        error: 'Demasiadas solicitudes de recuperación. Espera unos minutos e inténtalo de nuevo.'
      });
    }

    const serverEmailConfig = await readServerEmailConfig().catch(() => DEFAULT_SITE_CONFIG.email);
    if (serverEmailConfig.templates?.auth?.resetPassword?.enabled === false) {
      return res.json({ success: true, mode: 'disabled' });
    }

    const mailjetConfigured = Boolean(
      process.env.MAILJET_API_KEY?.trim() && process.env.MAILJET_SECRET_KEY?.trim()
    );
    const adminAuth = getAdminAuth();
    if (!mailjetConfigured || !adminAuth) {
      return res.json({ success: false, fallbackToClient: true });
    }

    const continueUrl = resolveSafeContinueUrl(req.body?.origin);
    let resetLink: string;
    let displayName: string | undefined;

    try {
      const userRecord = await adminAuth.getUserByEmail(cleanEmail);
      displayName = userRecord.displayName || undefined;
      resetLink = await adminAuth.generatePasswordResetLink(cleanEmail, { url: continueUrl });
    } catch (err: any) {
      const code = String(err?.code || '');
      if (code === 'auth/user-not-found') {
        // Evitar enumeración de cuentas: devolver respuesta neutra exitosa sin enviar correo
        return res.json({ success: true, mode: 'ignored' });
      }
      if (isAdminCredentialError(err)) {
        return res.json({ success: false, fallbackToClient: true });
      }
      console.warn('[Auth Mailjet] Error generando enlace resetPassword:', err);
      return res.json({ success: false, fallbackToClient: true });
    }

    const mjRes = await sendAuthTransactionalEmail({
      type: 'resetPassword',
      toEmail: cleanEmail,
      recipientName: displayName,
      actionUrl: resetLink,
      emailConfig: serverEmailConfig
    });

    if (!mjRes.success) {
      return res.json({ success: false, fallbackToClient: true });
    }

    const logId = `log_auth_reset_${Date.now()}`;
    await runWithAdminFirestore(
      (adminDb) =>
        adminDb.collection('email_logs').doc(logId).set({
          id: logId,
          orderId: 'AUTH_RESET',
          to: cleanEmail,
          recipientName: displayName || cleanEmail.split('@')[0],
          subject:
            serverEmailConfig.templates?.auth?.resetPassword?.subject ||
            'Restablecer tu contraseña',
          status: 'sent',
          timestamp: new Date().toISOString(),
          source: 'mailjet_auth'
        }),
      'log-auth-reset-email'
    ).catch(() => undefined);

    return res.json({ success: true, mode: 'mailjet' });
  } catch (err: any) {
    return res.status(500).json({
      success: false,
      fallbackToClient: true,
      error: err?.message || 'Error enviando correo de recuperación.'
    });
  }
});

/**
 * 4a-bis. Enviar email de prueba real con Mailjet desde el diseñador de plantillas (solo staff)
 * POST /api/emails/send-test
 */
app.post('/api/emails/send-test', async (req, res) => {
  try {
    const idToken = extractBearerToken(req.headers.authorization);
    if (!idToken) {
      return res.status(401).json({ success: false, error: 'Se requiere autenticación.' });
    }
    const verifiedUser = await verifyFirebaseIdToken(idToken);
    if (!verifiedUser) {
      return res.status(401).json({ success: false, error: 'Token inválido o expirado.' });
    }
    const callerRole = await getCallerRoleServer(idToken, verifiedUser);
    if (!callerRole.isStaff) {
      return res.status(403).json({ success: false, error: 'Solo el equipo administrador puede enviar pruebas.' });
    }

    const { toEmail, subject, htmlContent, senderName, replyToEmail } = req.body || {};
    const cleanTo = String(toEmail || verifiedUser.email || '').trim();
    if (!cleanTo || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(cleanTo)) {
      return res.status(400).json({ success: false, error: 'Introduce un correo de destino válido.' });
    }
    if (!htmlContent) {
      return res.status(400).json({ success: false, error: 'Falta el contenido HTML de la plantilla.' });
    }
    if (!process.env.MAILJET_API_KEY?.trim() || !process.env.MAILJET_SECRET_KEY?.trim()) {
      return res.status(503).json({
        success: false,
        error: 'Faltan MAILJET_API_KEY y/o MAILJET_SECRET_KEY en las variables de entorno.'
      });
    }

    const safeHtml = String(htmlContent).replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '');
    const cleanSubject = `[PRUEBA] ${String(subject || "Plantilla Transaccional · Chloe's Secrets World").slice(0, 180)}`;

    const mjRes = await sendMailjetEmail({
      to: { email: cleanTo, name: cleanTo.split('@')[0] },
      fromName: String(senderName || '').trim() || undefined,
      replyToEmail: String(replyToEmail || '').trim() || undefined,
      subject: cleanSubject,
      textPart: `Prueba de plantilla transaccional enviada desde el Diseñador Mailjet (${cleanSubject}).`,
      htmlPart: safeHtml
    });

    if (!mjRes.success) {
      return res.status(502).json({
        success: false,
        error: mjRes.error || 'Mailjet no aceptó el envío de prueba.'
      });
    }

    return res.json({
      success: true,
      recipient: cleanTo,
      message: `Email de prueba real enviado vía Mailjet a ${cleanTo}.`
    });
  } catch (err: any) {
    return res.status(500).json({ success: false, error: err?.message || 'Error enviando prueba Mailjet.' });
  }
});

/**
 * 4b. Descargar PDF de etiqueta Packlink o Hoja de Envío Discreto de una orden (solo staff)
 * GET /api/orders/:orderId/shipping-pdf?type=auto|slip|packlink&download=1
 */
app.get('/api/orders/:orderId/shipping-pdf', async (req, res) => {
  try {
    const idToken = extractBearerToken(req.headers.authorization);
    if (!idToken) {
      return res.status(401).json({ error: 'Se requiere autenticación de Firebase (Authorization: Bearer).' });
    }

    const verifiedUser = await verifyFirebaseIdToken(idToken);
    if (!verifiedUser) {
      return res.status(401).json({ error: 'Token de Firebase inválido o expirado.' });
    }

    const callerRole = await getCallerRoleServer(idToken, verifiedUser);
    if (!callerRole.isStaff) {
      return res.status(403).json({ error: 'Solo el equipo administrador puede descargar documentos de envío.' });
    }

    const orderId = String(req.params.orderId || '').trim();
    const resolved = await readOrderServer(orderId, idToken);
    if (!resolved) {
      return res.status(404).json({ error: 'Pedido no encontrado.' });
    }

    const requestedType = String(req.query.type || 'auto').toLowerCase();
    const disposition = String(req.query.download || '') === '1' ? 'attachment' : 'inline';
    const order = resolved.order;
    const plRef = order?.packlink?.reference ? String(order.packlink.reference).trim() : '';
    const labelUrl = order?.packlink?.labelUrl ? String(order.packlink.labelUrl).trim() : null;

    if ((requestedType === 'packlink' || requestedType === 'auto') && (labelUrl || plRef)) {
      const resolvedLabel = await fetchPacklinkLabelDirectOrUrl(plRef, labelUrl);
      if (resolvedLabel?.buffer) {
        res.setHeader('Content-Type', 'application/pdf');
        res.setHeader('Content-Disposition', `${disposition}; filename="Etiqueta-Packlink-${orderId}.pdf"`);
        return res.send(resolvedLabel.buffer);
      }
      if (requestedType === 'packlink') {
        const errorMsg = plRef
          ? `La etiqueta oficial del envío ${plRef} aún no está emitida en Packlink PRO. Confirma/paga el borrador en pro.packlink.com y vuelve a pulsar Sync.`
          : 'Este pedido aún no tiene una referencia creada en Packlink PRO. Asígnalo y pulsa Sync en Admin → Envío.';
        return res.status(404).json({ error: errorMsg });
      }
    }

    const origin = await readPacklinkSettings(idToken);
    const slipPdf = await generateOrderShippingPdfBuffer(order, origin);
    res.setHeader('Content-Type', 'application/pdf');
    res.setHeader('Content-Disposition', `${disposition}; filename="Hoja-Envio-Discreto-${orderId}.pdf"`);
    return res.send(slipPdf);
  } catch (err: any) {
    console.error('[ShippingPDF] Error generando PDF de envío:', err);
    return res.status(500).json({ error: err?.message || 'No se pudo generar el PDF de envío.' });
  }
});

/**
