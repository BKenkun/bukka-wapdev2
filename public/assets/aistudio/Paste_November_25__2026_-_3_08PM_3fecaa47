app.post('/api/i18n/translate', async (req, res) => {
  try {
    const targetLang = String(req.body?.targetLang || 'ES').toUpperCase() as SupportedLanguageCode;
    const rawItems = Array.isArray(req.body?.items) ? req.body.items : [];

    if (!['ES', 'EN', 'FR', 'DE', 'IT', 'PT'].includes(targetLang)) {
      return res.status(400).json({ success: false, error: 'Idioma de destino no válido.' });
    }

    if (rawItems.length === 0) {
      return res.json({
        success: true,
        targetLang,
        translations: {},
        translatedByText: {},
        fromCacheCount: 0,
        fromAiCount: 0
      });
    }

    const sanitizedItems = rawItems
      .slice(0, 80)
      .map((item: any, idx: number) => ({
        key: String(item?.key || `k_${idx}`).slice(0, 120),
        text: String(item?.text || '').slice(0, 1200)
      }));

    const result = await translateBatchWithGemini(targetLang, sanitizedItems);
    return res.json({
      success: true,
      targetLang,
      ...result
    });
  } catch (err: any) {
    const msg = err?.message || 'Error al traducir con Gemini.';
    const status = msg.includes('GEMINI_API_KEY') ? 503 : 502;
    console.error('[i18n/translate] Error:', msg);
    return res.status(status).json({
      success: false,
      error: msg
    });
  }
});

app.post('/api/i18n/resolve-preference', async (req, res) => {
  try {
    const queryText = String(req.body?.query || '').trim();
    const currentLanguage = String(req.body?.currentLanguage || 'ES').toUpperCase() as SupportedLanguageCode;
    const currentCurrency = String(req.body?.currentCurrency || 'EUR').toUpperCase() as SupportedCurrencyCode;

    if (!queryText) {
      return res.status(400).json({ success: false, error: 'Escribe tu preferencia de idioma o divisa.' });
    }

    const resolved = await resolvePreferenceWithGemini(
      queryText.slice(0, 400),
      currentLanguage,
      currentCurrency
    );
    return res.json({ success: true, ...resolved });
  } catch (err: any) {
    const msg = err?.message || 'No se pudo procesar tu preferencia con Gemini.';
    const status = msg.includes('GEMINI_API_KEY') ? 503 : 502;
    console.error('[i18n/resolve-preference] Error:', msg);
    return res.status(status).json({
      success: false,
      error: msg
    });
  }
});

// Cabecera HTTP noindex para rutas privadas de checkout, suscripción y retornos
app.use(['/checkout', '/subscription', '/account/subscription'], (_req, res, next) => {
  res.setHeader('X-Robots-Tag', 'noindex, nofollow');
  next();
});

app.get('/api/health', (_req, res) => {
  res.status(200).json({ ok: true, status: 'healthy' });
});

app.use('/api', (_req, res) => {
  res.status(404).json({ success: false, message: 'Ruta de API no encontrada.' });
});

// Configuración de Vite para desarrollo y servicio de estáticos en producción
async function startServer() {
  if (process.env.NODE_ENV !== 'production') {
    const { createServer: createViteServer } = await import('vite');
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: 'spa'
    });
    app.use(vite.middlewares);
  } else {
    app.use(express.static(path.resolve(__dirname, 'dist')));
    app.get('*', (_req, res) => {
      res.sendFile(path.resolve(__dirname, 'dist', 'index.html'));
    });
  }

  app.listen(PORT, '0.0.0.0', () => {
    console.log(`[Chloe's Secrets] Servidor full-stack iniciado en http://0.0.0.0:${PORT}`);
  });
}

startServer();
