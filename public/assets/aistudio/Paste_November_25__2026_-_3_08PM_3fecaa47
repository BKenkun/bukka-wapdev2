/**
 * 4. Endpoint de Servicio de Correos Transaccionales (Confirmación de Compra)
 * Integrado con el patrón Firebase Cloud Functions
 * POST /api/functions/send-order-email
 */
app.post('/api/functions/send-order-email', async (req, res) => {
  try {
    const idToken = extractBearerToken(req.headers.authorization);
    if (!idToken) {
      return res.status(401).json({
        success: false,
        error: 'Se requiere autenticación de Firebase (Authorization: Bearer).'
      });
    }

    const verifiedUser = await verifyFirebaseIdToken(idToken);
    if (!verifiedUser) {
      return res.status(401).json({
        success: false,
        error: 'Token de Firebase inválido o expirado.'
      });
    }

    const { orderId, logId, customerEmail, subject, htmlContent, senderName, replyToEmail } =
      req.body || {};
    if (!orderId || !customerEmail || !htmlContent) {
      return res.status(400).json({ error: 'Faltan parámetros requeridos (orderId, customerEmail, htmlContent)' });
    }

    const cleanEmail = String(customerEmail).trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(cleanEmail)) {
      return res.status(400).json({ error: 'Correo electrónico de destino inválido.' });
    }

    const callerRole = await getCallerRoleServer(idToken, verifiedUser);
    const accessCheck = await verifyOrderEmailAccessServer(
      idToken,
      callerRole,
      String(orderId),
      cleanEmail
    );
    if (!accessCheck.allowed) {
      return res.status(403).json({
        success: false,
        error: accessCheck.reason || 'Permisos insuficientes para enviar este correo de pedido.'
      });
    }

    const serverEmailConfig = await readServerEmailConfig().catch(() => DEFAULT_SITE_CONFIG.email);
    const safeHtmlContent = String(htmlContent).replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '');
    const defaultSubjectTpl =
      serverEmailConfig.templates?.orders?.orderConfirmation?.subject ||
      "Confirmación de tu pedido #{orderId} - Chloe's Secrets World";
    const emailSubject = String(
      subject || defaultSubjectTpl.replaceAll('{orderId}', String(orderId))
    ).slice(0, 200);
    const resolvedSenderName = String(senderName || serverEmailConfig.senderName || '').trim();
    const resolvedReplyTo = String(replyToEmail || serverEmailConfig.replyToEmail || '').trim();
    const cleanLogId = typeof logId === 'string' && /^[a-zA-Z0-9_-]{3,128}$/.test(logId) ? logId : null;

    // 1. Envío inmediato por Mailjet si está configurado
    if (process.env.MAILJET_API_KEY?.trim() && process.env.MAILJET_SECRET_KEY?.trim()) {
      const mjRes = await sendMailjetEmail({
        to: {
          email: cleanEmail,
          name: String(req.body?.customerName || 'Cliente VIP')
        },
        fromName: resolvedSenderName,
        replyToEmail: resolvedReplyTo,
        subject: emailSubject,
        textPart: `Confirmación de tu pedido #${orderId} en ${resolvedSenderName || "Chloe's Secrets World"}.`,
        htmlPart: safeHtmlContent
      });

      if (mjRes.success) {
        if (cleanLogId) {
          await runWithAdminFirestore(
            (adminDb) =>
              adminDb.collection('email_logs').doc(cleanLogId).set(
                {
                  status: 'sent',
                  source: 'mailjet',
                  updatedAt: new Date().toISOString()
                },
                { merge: true }
              ),
            'update-email-log-mailjet'
          ).catch(() => undefined);
        }
        return res.json({
          success: true,
          mode: 'mailjet',
          messageId: `mj_${orderId}_${Date.now()}`,
          recipient: cleanEmail,
          orderId
        });
      }

      if (cleanLogId) {
        await runWithAdminFirestore(
          (adminDb) =>
            adminDb.collection('email_logs').doc(cleanLogId).set(
              {
                status: 'error',
                source: 'mailjet',
                errorDetails: mjRes.error || 'Error al despachar con Mailjet',
                updatedAt: new Date().toISOString()
              },
              { merge: true }
            ),
          'update-email-log-mailjet-error'
        ).catch(() => undefined);
      }

      return res.status(502).json({
        success: false,
        mode: 'mailjet',
        error: mjRes.error || 'Mailjet rechazó el envío del correo.'
      });
    }

    const smtpConfig = buildSmtpTransportConfig(serverEmailConfig);

    if (smtpConfig) {
      const nodemailer = (await import('nodemailer')).default;
      const transporter = nodemailer.createTransport({
        host: smtpConfig.smtpHost,
        port: smtpConfig.smtpPort,
        secure: smtpConfig.smtpPort === 465,
        auth: {
          user: smtpConfig.smtpAccount,
          pass: smtpConfig.smtpSecret
        }
      });

      const info = await transporter.sendMail({
        from: smtpConfig.fromHeader,
        to: cleanEmail,
        replyTo: resolvedReplyTo || undefined,
        subject: emailSubject,
        html: safeHtmlContent
      });

      if (cleanLogId) {
        await runWithAdminFirestore(
          (adminDb) =>
            adminDb.collection('email_logs').doc(cleanLogId).set(
              { status: 'sent', source: 'smtp', updatedAt: new Date().toISOString() },
              { merge: true }
            ),
          'update-email-log-smtp'
        ).catch(() => undefined);
      }

      console.log(`[Email Service] Correo real enviado vía SMTP a ${cleanEmail} (ID: ${info.messageId})`);
      return res.json({
        success: true,
        mode: 'smtp',
        messageId: info.messageId,
        recipient: cleanEmail,
        orderId
      });
    }

    // Modo Sandbox / Cola si aún no se han configurado credenciales Mailjet o SMTP
    console.log(`[Email Service - Cola pendiente] Correo para #${orderId} registrado para ${cleanEmail}.`);
    return res.json({
      success: true,
      mode: 'sandbox',
      messageId: `queue_${Date.now()}`,
      orderId,
      recipient: cleanEmail,
      note: 'Mailjet no configurado: correo registrado en cola para revisión manual.'
    });
  } catch (err: any) {
    console.error('[Email Service] Error enviando correo:', err);
    return res.status(500).json({ error: err.message || 'Error en el servidor de correo' });
  }
});

