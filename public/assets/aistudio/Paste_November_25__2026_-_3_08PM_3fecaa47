        : undefined;

    const packlink = await syncOrderPacklinkShipment(resolved.order, {
      docPath: resolved.docPath,
      idToken,
      forceRefresh: true,
      autoSelectPacklink: Boolean(autoSelectPacklink),
      serviceOverride
    });

    return res.json({
      success: true,
      orderId,
      packlink
    });
  } catch (err: any) {
    console.error('[PacklinkSync] Error sincronizando envío:', err);
    return res.status(500).json({
      success: false,
      error: err?.message || 'No se pudo sincronizar el envío con Packlink.'
    });
