interface CheckoutFormValues {
  name: string;
  email: string;
  phone: string;
  street: string;
  city: string;
  state: string;
  postalCode: string;
  country: string;
  saveAddress: boolean;
}

type FieldErrors = Partial<Record<keyof CheckoutFormValues, string>>;

const FIELD_LABELS: Record<keyof CheckoutFormValues, string> = {
  name: 'Nombre completo',
  email: 'Correo electrónico',
  phone: 'Teléfono de contacto',
  street: 'Dirección de entrega',
  city: 'Ciudad',
  state: 'Provincia / Estado',
  postalCode: 'Código postal',
  country: 'País',
  saveAddress: 'Guardar dirección'
};

function validateCheckoutValues(values: CheckoutFormValues): {
  valid: boolean;
  fieldErrors: FieldErrors;
  lines: string[];
} {
  const fieldErrors: FieldErrors = {};

  if (values.name.trim().length < 3) {
    fieldErrors.name = 'Introduce tu nombre y apellidos completos (mínimo 3 caracteres).';
  }

  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!emailRegex.test(values.email.trim())) {
    fieldErrors.email = 'Introduce una dirección de correo electrónico válida.';
  }

  const cleanDigits = values.phone.replace(/[^\d]/g, '');
  if (cleanDigits.length < 9) {
    fieldErrors.phone = 'El número de teléfono debe contener al menos 9 dígitos.';
  }

  if (values.street.trim().length < 5) {
    fieldErrors.street = 'Indica calle, número y piso o puerta (mínimo 5 caracteres).';
  }

  if (values.city.trim().length < 2) {
    fieldErrors.city = 'La ciudad es obligatoria.';
  }

  if (values.state.trim().length < 2) {
    fieldErrors.state = 'La provincia o comunidad es obligatoria.';
  }

  const cleanCountry = values.country.trim().toUpperCase();
  const isSpain =
    cleanCountry === 'ESPAÑA' ||
    cleanCountry === 'ESPANA' ||
    cleanCountry === 'SPAIN' ||
    cleanCountry === 'ES';

  if (isSpain && !/^\d{5}$/.test(values.postalCode.trim())) {
    fieldErrors.postalCode = 'En España el código postal debe tener exactamente 5 dígitos (ej. 28001).';
  } else if (values.postalCode.trim().length < 3) {
    fieldErrors.postalCode = 'Introduce un código postal válido.';
  }

  if (values.country.trim().length < 2) {
    fieldErrors.country = 'El país de entrega es obligatorio.';
  }

  const lines = (Object.keys(fieldErrors) as (keyof CheckoutFormValues)[]).map(
    (key) => `${FIELD_LABELS[key]}: ${fieldErrors[key]}`
  );

  return {
    valid: lines.length === 0,
    fieldErrors,
    lines
  };
}

function formatEur(amount: number): string {
  return `${amount.toFixed(2).replace('.', ',')} €`;
}

function parseFirebaseAuthError(err: any): string {
  const code = err?.code || '';
  if (code === 'auth/user-not-found') {
    return 'No existe ninguna cuenta con este correo. Puedes crear una seleccionando "2. Crear una cuenta".';
  }
  if (code === 'auth/wrong-password' || code === 'auth/invalid-credential') {
    return 'Correo electrónico o contraseña incorrectos. Verifica tus datos.';
  }
  if (code === 'auth/email-already-in-use') {
    return 'Ya existe una cuenta registrada con este correo electrónico. Selecciona "1. Iniciar sesión".';
  }
  if (code === 'auth/weak-password') {
    return 'La contraseña es demasiado débil (mínimo 6 caracteres).';
  }
  if (code === 'auth/invalid-email') {
    return 'El formato del correo electrónico no es válido.';
  }
  if (code === 'auth/too-many-requests') {
    return 'Demasiados intentos consecutivos. Espera unos instantes antes de volver a intentarlo.';
  }
  if (code === 'auth/popup-closed-by-user') {
    return 'Ventana de acceso con Google cerrada antes de finalizar.';
  }
  if (code === 'auth/popup-blocked') {
    return 'Tu navegador bloqueó la ventana emergente de Google. Permítela para continuar.';
  }
  if (code === 'auth/operation-not-allowed') {
    return 'El acceso con correo/contraseña requiere estar habilitado en Firebase Authentication, o accede en 1 clic con Google.';
  }
  return err?.message || 'No se pudo completar la autenticación. Inténtalo de nuevo.';
}

const Stepper: React.FC<{
  currentStep: number;
  onSelectStep: (step: number) => void;
}> = ({ currentStep, onSelectStep }) => {
  const steps = [
    { number: 1, name: 'Confirmar Bolsa' },
    { number: 2, name: 'Tus Datos y Envío' },
    { number: 3, name: 'Revisión y Pago' }
  ];

  return (
    <div className="flex items-center justify-center max-w-2xl mx-auto mb-10 px-2">
      {steps.map((s, index) => {
        const isActive = currentStep >= s.number;
        const isClickable = s.number < currentStep;
        return (
          <React.Fragment key={s.number}>
            <button
              type="button"
              disabled={!isClickable}
              onClick={() => isClickable && onSelectStep(s.number)}
              className={`flex flex-col items-center group ${
                isClickable ? 'cursor-pointer' : 'cursor-default'
              }`}
            >
              <div
                className={`flex items-center justify-center h-10 w-10 rounded-full border-2 text-sm transition-all tabular-nums ${
                  isActive
                    ? 'bg-[#0f2d27] border-[#0f2d27] text-white font-bold shadow-xs'
                    : 'border-neutral-300 text-neutral-400 bg-neutral-50 font-medium'
                } ${isClickable ? 'group-hover:bg-teal-800 group-hover:border-teal-800' : ''}`}
              >
                {currentStep > s.number ? <CheckCircle2 className="w-5 h-5 text-teal-300" /> : s.number}
              </div>
              <span
                className={`mt-2 text-xs tracking-wide whitespace-nowrap ${
                  isActive ? 'text-neutral-900 font-semibold' : 'text-neutral-400 font-medium'
                }`}
              >
                {s.name}
              </span>
            </button>
            {index < steps.length - 1 && (
              <div
                className={`flex-1 h-0.5 mx-3 sm:mx-5 transition-all ${
                  currentStep > index + 1 ? 'bg-[#0f2d27]' : 'bg-neutral-200'
                }`}
              />
            )}
          </React.Fragment>
        );
      })}
    </div>
  );
};

export const CheckoutView: React.FC = () => {
  const {
    cart,
    updateCartQuantity,
    removeFromCart,
    clearCart,
    cartSubtotal,
    volumeDiscount,
    volumeDiscountPercent,
    cartDiscount,
    freeShippingThreshold,
    appliedPromo,
    validatePromoCodeAsync,
    removePromoCode,
    user,
    userProfile,
    isAuthLoading,
    loginWithEmail,
    loginWithGoogle,
    registerWithEmail,
    sendPasswordReset,
    logout,
    updateUserProfile,
    addOrder,
    setCurrentView,
    setIsAccountModalOpen
  } = useStore();
  const { setCheckoutData, clearCheckoutData, setPaymentMethod: setContextPaymentMethod } = useCheckout();
  const { currency, formatPrice, t } = useLocale();

  const totalUnits = useMemo(() => cart.reduce((acc, item) => acc + item.quantity, 0), [cart]);

  const [step, setStep] = useState<number>(1);
  const [checkoutMode, setCheckoutMode] = useState<'guest' | 'login' | 'register'>('guest');

  // Form values
  const [formValues, setFormValues] = useState<CheckoutFormValues>({
    name: '',
    email: '',
    phone: '',
    street: '',
    city: '',
    state: '',
    postalCode: '',
    country: 'España',
    saveAddress: true
  });
  const [fieldErrors, setFieldErrors] = useState<FieldErrors>({});
  const [selectedAddressId, setSelectedAddressId] = useState<string | null>(null);
  const [brokenImages, setBrokenImages] = useState<Record<string, boolean>>({});

  // Inline Login state (Step 2)
  const [loginEmail, setLoginEmail] = useState('');
  const [loginPassword, setLoginPassword] = useState('');
  const [showLoginPassword, setShowLoginPassword] = useState(false);
  const [loginLoading, setLoginLoading] = useState(false);
  const [googleLoginLoading, setGoogleLoginLoading] = useState(false);
  const [loginError, setLoginError] = useState<string | null>(null);
  const [resetEmailSent, setResetEmailSent] = useState<string | null>(null);

  // Inline Register state (Step 2)
  const [registerPassword, setRegisterPassword] = useState('');
  const [showRegisterPassword, setShowRegisterPassword] = useState(false);
  const [registerLoading, setRegisterLoading] = useState(false);
  const [registerError, setRegisterError] = useState<string | null>(null);
  const [emailExistsConflict, setEmailExistsConflict] = useState(false);

  // Packlink Shipping Quotes
  const [packlinkQuotes, setPacklinkQuotes] = useState<PacklinkQuote[]>([]);
  const [selectedQuoteId, setSelectedQuoteId] = useState<string | null>(null);
  const [packlinkLoading, setPacklinkLoading] = useState(false);
  const [packlinkSource, setPacklinkSource] = useState<'packlink_live' | 'zonal_fallback' | null>(null);
  const [packlinkQuoteError, setPacklinkQuoteError] = useState<string | null>(null);
  const [quotesLoadedKey, setQuotesLoadedKey] = useState<string | null>(null);

  // Step 3 Coupon & Payment state
  const [couponInput, setCouponInput] = useState('');
  const [couponLoading, setCouponLoading] = useState(false);
  const [selectedPaymentMethod, setSelectedPaymentMethod] = useState<'card' | 'bizum'>('card');
  const [submittingOrder, setSubmittingOrder] = useState(false);

  // Feedback & Error Panels (modeled on reference architecture)
  const [noticeBanner, setNoticeBanner] = useState<{
    type: 'success' | 'error' | 'info';
    title: string;
    message: string;
  } | null>(null);
  const [step2ValidationLines, setStep2ValidationLines] = useState<string[] | null>(null);
  const [paymentError, setPaymentError] = useState<string | null>(null);
  const [paymentErrorKind, setPaymentErrorKind] = useState<'gateway' | 'local' | null>(null);
  const [payStepDetail, setPayStepDetail] = useState<{
    title: string;
    items: string[];
    hint?: string;
  } | null>(null);

  // Hilow Gateway Modal & Confirmed Order Receipt
  const [hilowSession, setHilowSession] = useState<{
    isOpen: boolean;
    orderId: string;
    amountInCents: number;
    productName: string;
    customerEmail: string;
    paymentUrl: string;
    orderObj: Order;
  } | null>(null);
  const [completedOrder, setCompletedOrder] = useState<Order | null>(null);

  // Pre-fill form when user or userProfile loads
  useEffect(() => {
    if (user) {
      const addresses: SavedAddress[] = userProfile?.addresses || [];
      const defaultAddr = addresses.find((a) => a.isDefault) || addresses[0];

      setFormValues((prev) => ({
        ...prev,
        email: user.email || prev.email,
        name: defaultAddr?.name || userProfile?.displayName || user.displayName || prev.name,
        phone: defaultAddr?.phone || userProfile?.phoneNumber || prev.phone,
        street: defaultAddr?.street || prev.street,
        city: defaultAddr?.city || prev.city,
        state: defaultAddr?.state || defaultAddr?.city || prev.state,
        postalCode: defaultAddr?.postalCode || prev.postalCode,
        country: defaultAddr?.country || prev.country || 'España',
        saveAddress: addresses.length === 0 ? true : prev.saveAddress
      }));

      if (defaultAddr && !selectedAddressId) {
        setSelectedAddressId(defaultAddr.id);
      }
    }
  }, [user, userProfile]);

  const showToast = useCallback(
    (type: 'success' | 'error' | 'info', title: string, message: string) => {
      setNoticeBanner({ type, title, message });
    },
    []
  );

  const updateField = <K extends keyof CheckoutFormValues>(
    field: K,
    value: CheckoutFormValues[K]
  ) => {
    setFormValues((prev) => ({ ...prev, [field]: value }));
    if (fieldErrors[field]) {
      setFieldErrors((prev) => {
        const next = { ...prev };
        delete next[field];
        return next;
      });
    }
    // If postalCode or country changes, invalidate stale shipping quotes so Step 2 recalculates fresh rates
    if (field === 'postalCode' || field === 'country') {
      setPacklinkQuotes([]);
      setSelectedQuoteId(null);
      setQuotesLoadedKey(null);
      setPacklinkQuoteError(null);
      setPacklinkSource(null);
    }
  };

  const handleSelectSavedAddress = (addr: SavedAddress) => {
    setSelectedAddressId(addr.id);
    setFormValues((prev) => ({
      ...prev,
      name: addr.name,
      phone: addr.phone,
      street: addr.street,
      city: addr.city,
      state: addr.state || addr.city,
      postalCode: addr.postalCode,
      country: addr.country || 'España',
      saveAddress: false
    }));
    setFieldErrors({});
    setStep2ValidationLines(null);
    setPacklinkQuotes([]);
    setSelectedQuoteId(null);
    setQuotesLoadedKey(null);
    setPacklinkQuoteError(null);
    setPacklinkSource(null);
  };

  const selectedQuote = useMemo(() => {
    if (!packlinkQuotes.length) return null;
    return packlinkQuotes.find((q) => q.serviceId === selectedQuoteId) || packlinkQuotes[0];
  }, [packlinkQuotes, selectedQuoteId]);

  const cheapestQuoteId = useMemo(() => {
    if (!packlinkQuotes.length) return null;
    return packlinkQuotes[0].serviceId;
  }, [packlinkQuotes]);

  const finalTotals = useMemo(() => {
    const subtotal = Number(cartSubtotal.toFixed(2));
    const subtotalWithDiscounts = Number(
      Math.max(0, subtotal - volumeDiscount - cartDiscount).toFixed(2)
    );
    const qualifiesForFreeStandard =
      subtotalWithDiscounts >= freeShippingThreshold ||
      appliedPromo?.discountType === 'free_shipping';

    // Standard shipping is free when threshold/coupon applies; if user explicitly picks Express upgrade, charge only the quote or upgrade
    let shippingCost = 0;
    if (!selectedQuote) {
      shippingCost = qualifiesForFreeStandard ? 0 : 5.99;
    } else if (qualifiesForFreeStandard && selectedQuote.serviceId === cheapestQuoteId) {
      shippingCost = 0;
    } else {
      shippingCost = Number(selectedQuote.price.toFixed(2));
    }

    const total = Number((subtotalWithDiscounts + shippingCost).toFixed(2));
    const priceInCents = Math.round(total * 100);
    const estimatedPoints = Math.max(1, Math.floor(total));

    return {
      subtotal,
      subtotalWithDiscounts,
      shippingCost,
      total,
      priceInCents,
      isFreeShipping: shippingCost === 0 && (cart.length > 0 || qualifiesForFreeStandard),
      qualifiesForFreeStandard,
      estimatedPoints
    };
  }, [
    cartSubtotal,
    volumeDiscount,
    cartDiscount,
    freeShippingThreshold,
    appliedPromo,
    selectedQuote,
    cheapestQuoteId,
    cart.length
  ]);

  const freeShippingRemaining = useMemo(() => {
    if (appliedPromo?.discountType === 'free_shipping') return 0;
    return Number(
      Math.max(0, freeShippingThreshold - finalTotals.subtotalWithDiscounts).toFixed(2)
    );
  }, [appliedPromo, freeShippingThreshold, finalTotals.subtotalWithDiscounts]);

  const goToStep = (next: number) => {
    setPaymentError(null);
    setPaymentErrorKind(null);
    setPayStepDetail(null);
    setStep2ValidationLines(null);
    setNoticeBanner(null);
    setStep(next);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // Inline Login handler (Step 2)
  const handleInlineLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoginError(null);
    setResetEmailSent(null);
    if (!loginEmail.trim() || !loginPassword) {
      setLoginError('Introduce tu correo electrónico y tu contraseña.');
      return;
    }
    setLoginLoading(true);
    try {
      const loggedUser = await loginWithEmail(loginEmail.trim(), loginPassword);
      setFormValues((prev) => ({
        ...prev,
        email: loggedUser.email || loginEmail.trim(),
        name: loggedUser.displayName || prev.name
      }));
      showToast(
        'success',
        'Sesión iniciada correctamente',
        'Tus datos se han cargado. Verifica tu dirección de entrega y continúa.'
      );
    } catch (err: any) {
      setLoginError(parseFirebaseAuthError(err));
    } finally {
      setLoginLoading(false);
    }
  };

  // Inline Password Reset inside Step 2 (so user never hits a dead link)
  const handleInlinePasswordReset = async () => {
    setLoginError(null);
    setResetEmailSent(null);
    if (!loginEmail.trim()) {
      setLoginError('Escribe primero tu correo electrónico arriba para enviarte el enlace de recuperación.');
      return;
    }
    setLoginLoading(true);
    try {
      await sendPasswordReset(loginEmail.trim());
      setResetEmailSent(
        `Hemos enviado un enlace para restablecer tu contraseña a ${loginEmail.trim()}.`
      );
    } catch (err: any) {
      setLoginError(parseFirebaseAuthError(err));
    } finally {
      setLoginLoading(false);
    }
  };

  // Inline 1-Click Google Auth inside Step 2
  const handleInlineGoogleLogin = async () => {
    setLoginError(null);
    setRegisterError(null);
    setGoogleLoginLoading(true);
    try {
      const googleUser = await loginWithGoogle();
      setFormValues((prev) => ({
        ...prev,
        email: googleUser.email || prev.email,
        name: prev.name || googleUser.displayName || ''
      }));
      showToast(
        'success',
        'Cuenta de Google conectada',
        'Revisa tu dirección de envío discreto para continuar al pago.'
      );
    } catch (err: any) {
      const msg = parseFirebaseAuthError(err);
      setLoginError(msg);
      if (checkoutMode === 'register') {
        setRegisterError(msg);
      }
    } finally {
      setGoogleLoginLoading(false);
    }
  };

  // Sign out to switch account or buy as guest
  const handleSignOut = async () => {
    try {
      await logout();
      setSelectedAddressId(null);
      setFormValues((prev) => ({
        ...prev,
        name: '',
        email: ''
      }));
      setCheckoutMode('guest');
      showToast(
        'info',
        'Sesión cerrada',
        'Ahora puedes finalizar tu pedido como invitado o iniciar sesión con otra cuenta.'
      );
    } catch (err) {
      console.error('Error cerrando sesión en checkout:', err);
    }
  };

  const buildShippingQuoteKey = useCallback((postalCode: string, country: string) => {
    return `${postalCode.trim()}::${country.trim().toUpperCase()}`;
  }, []);

  const isPostalReadyForQuote = useCallback((postalCode: string, country: string) => {
    const cleanPostal = postalCode.trim();
    const cleanCountry = country.trim().toUpperCase();
    if (!cleanCountry || cleanCountry.length < 2) return false;
    const isSpain =
      cleanCountry === 'ESPAÑA' ||
      cleanCountry === 'ESPANA' ||
      cleanCountry === 'SPAIN' ||
      cleanCountry === 'ES';
    return isSpain ? /^\d{5}$/.test(cleanPostal) : cleanPostal.length >= 3;
  }, []);

  // Calculate Packlink shipping rates
  const calculateShippingRate = useCallback(
    async (
      values: { postalCode: string; country: string },
      options?: { silentErrorToast?: boolean }
    ): Promise<boolean> => {
      const requestKey = buildShippingQuoteKey(values.postalCode, values.country);
      setPacklinkLoading(true);
      setPacklinkQuoteError(null);
      try {
        const result = await getPacklinkShippingQuotes({
          postalCode: values.postalCode,
          country: values.country
        });

        if (!result.success || !result.quotes?.length) {
          throw new Error(
            result.message || 'No se encontraron tarifas de mensajería para este código postal.'
          );
        }

        const validQuotes = result.quotes.filter(
          (q) => Number.isFinite(q.price) && q.price >= 0
        );
        const payableQuotes = !finalTotals.qualifiesForFreeStandard
          ? validQuotes.filter((q) => q.price > 0)
          : validQuotes;
        if (!payableQuotes.length) {
          throw new Error('No se pudo obtener una tarifa válida para el destino indicado.');
        }

        setPacklinkQuotes(payableQuotes);
        setPacklinkSource(result.source || null);
        setQuotesLoadedKey(requestKey);
        setSelectedQuoteId((prev) =>
          prev && payableQuotes.some((q) => q.serviceId === prev)
            ? prev
            : payableQuotes[0].serviceId
        );
        return true;
      } catch (err: any) {
        const msg = err?.message || 'No se pudo calcular el coste de envío.';
        setPacklinkQuoteError(msg);
        if (!options?.silentErrorToast) {
          setStep2ValidationLines([msg]);
          showToast('error', 'Error al calcular el envío', msg);
        }
        return false;
      } finally {
        setPacklinkLoading(false);
      }
    },
    [buildShippingQuoteKey, finalTotals.qualifiesForFreeStandard, showToast]
  );

  // Auto-load Packlink shipping options inside Step 2 as soon as destination Postal Code & Country are valid
  useEffect(() => {
    if (step !== 2) return;
    if (!isPostalReadyForQuote(formValues.postalCode, formValues.country)) return;
    const targetKey = buildShippingQuoteKey(formValues.postalCode, formValues.country);
    if (quotesLoadedKey === targetKey && packlinkQuotes.length > 0) return;

    const timer = window.setTimeout(() => {
      void calculateShippingRate(
        { postalCode: formValues.postalCode, country: formValues.country },
        { silentErrorToast: true }
      );
    }, 450);

    return () => window.clearTimeout(timer);
  }, [
    step,
    formValues.postalCode,
    formValues.country,
    quotesLoadedKey,
    packlinkQuotes.length,
    isPostalReadyForQuote,
    buildShippingQuoteKey,
    calculateShippingRate
  ]);

  // Step 1 -> Step 2
  const handleContinueFromStep1 = () => {
    if (cart.length === 0) {
      showToast('error', 'Tu bolsa está vacía', 'Añade al menos una prenda antes de tramitar el pedido.');
      return;
    }
    goToStep(2);
  };

  // Step 2 -> Step 3 (Validate + optional Account Creation + Packlink quote)
  const handleContinueFromStep2 = async () => {
    setStep2ValidationLines(null);
    setRegisterError(null);
    setEmailExistsConflict(false);
    setNoticeBanner(null);

    if (!user && checkoutMode === 'login') {
      setLoginError('Inicia sesión primero con tu correo o con Google, o selecciona "Comprar como invitado".');
      showToast(
        'error',
        'Inicia sesión para continuar',
        'Pulsa en "Iniciar sesión y cargar mis datos" o elige otra modalidad.'
      );
      return;
    }

    const validation = validateCheckoutValues(formValues);
    if (!validation.valid) {
      setFieldErrors(validation.fieldErrors);
      setStep2ValidationLines(validation.lines);
      showToast(
        'error',
        'Revisa los datos de envío',
        validation.lines[0] || 'Completa todos los campos obligatorios.'
      );
      return;
    }

    const primaryAddress: SavedAddress = {
      id: selectedAddressId || `addr_${Date.now()}`,
      alias: 'Principal',
      name: formValues.name.trim(),
      phone: formValues.phone.trim(),
      street: formValues.street.trim(),
      city: formValues.city.trim(),
      state: formValues.state.trim(),
      postalCode: formValues.postalCode.trim(),
      country: formValues.country.trim(),
      isDefault: true
    };

    // If user chose "2. Crear una cuenta", register them in Firebase Auth + Firestore now
    if (!user && checkoutMode === 'register') {
      if (!registerPassword || registerPassword.length < 6) {
        const pwdMsg = 'Crea una contraseña de al menos 6 caracteres para tu nueva cuenta.';
        setRegisterError(pwdMsg);
        showToast('error', 'Contraseña requerida', pwdMsg);
        return;
      }

      setRegisterLoading(true);
      try {
        await registerWithEmail(
          formValues.email.trim(),
          registerPassword,
          formValues.name.trim(),
          {
            phoneNumber: formValues.phone.trim(),
            addresses: [primaryAddress]
          }
        );
        showToast(
          'success',
          '¡Cuenta creada con éxito!',
          'Hemos guardado tu dirección y acumularás puntos VIP con este pedido.'
        );
      } catch (err: any) {
        const msg = parseFirebaseAuthError(err);
        setRegisterError(msg);
        if (err?.code === 'auth/email-already-in-use') {
          setEmailExistsConflict(true);
        }
        showToast('error', 'No se pudo crear la cuenta', msg);
        setRegisterLoading(false);
        return;
      } finally {
        setRegisterLoading(false);
      }
    } else if (user && formValues.saveAddress) {
      // Save or update address & phone on existing user's Firestore profile
      try {
        const existingAddresses = userProfile?.addresses || [];
        const withoutDuplicate = existingAddresses
          .filter(
            (a) =>
              a.id !== primaryAddress.id &&
              !(
                a.street.toLowerCase() === primaryAddress.street.toLowerCase() &&
                a.postalCode === primaryAddress.postalCode
              )
          )
          .map((a) => ({ ...a, isDefault: false }));

        await updateUserProfile({
          displayName: formValues.name.trim(),
          phoneNumber: formValues.phone.trim(),
          addresses: [primaryAddress, ...withoutDuplicate].slice(0, 5)
        });
      } catch (profileErr) {
        console.warn('No se pudo actualizar la libreta de direcciones:', profileErr);
      }
    }

    const currentQuoteKey = buildShippingQuoteKey(formValues.postalCode, formValues.country);
    const hasFreshSelection =
      quotesLoadedKey === currentQuoteKey && packlinkQuotes.length > 0 && Boolean(selectedQuote);

    const shippingOk = hasFreshSelection
      ? true
      : await calculateShippingRate(formValues);
    if (shippingOk) {
      goToStep(3);
    }
  };

  // Apply coupon in Step 3
  const handleApplyCoupon = useCallback(async () => {
    const code = couponInput.trim().toUpperCase();
    if (!code) return;
    setCouponLoading(true);
    try {
      const res = await validatePromoCodeAsync(code);
      if (!res.success) {
        showToast('error', 'Cupón no aplicable', res.message);
      } else {
        setCouponInput('');
        showToast('success', 'Cupón aplicado', res.message);
      }
    } catch (err: any) {
      showToast('error', 'Error al validar cupón', err?.message || 'Inténtalo de nuevo.');
    } finally {
      setCouponLoading(false);
    }
  }, [couponInput, validatePromoCodeAsync, showToast]);

  // Final Submit in Step 3
  const handleFinalSubmit = async () => {
    if (cart.length === 0 || finalTotals.total <= 0) {
      setPayStepDetail({
        title: 'No se puede procesar el pago',
        items: ['Tu bolsa de compra está vacía o el importe es 0,00 €.']
      });
      return;
    }

    const validation = validateCheckoutValues(formValues);
    if (!validation.valid) {
      setPaymentError(null);
      setPaymentErrorKind(null);
      setPayStepDetail({
        title: 'Faltan datos de entrega obligatorios',
        items: validation.lines,
        hint: 'Vuelve al Paso 2 para revisar y completar tu dirección de envío.'
      });
      return;
    }

    if (
      !finalTotals.isFreeShipping &&
      (!selectedQuote || !Number.isFinite(selectedQuote.price) || selectedQuote.price <= 0)
    ) {
      setPayStepDetail({
        title: 'Cálculo de envío pendiente',
        items: ['Vuelve al Paso 2 para confirmar tu código postal y obtener la tarifa de envío.']
      });
      return;
    }

    setSubmittingOrder(true);
    setPaymentError(null);
    setPaymentErrorKind(null);
    setPayStepDetail(null);

    const isGuestOrder = !user;
    const cleanUid = user ? user.uid : 'guest';
    const orderId = `CS_${cleanUid}_${Date.now()}`;

    const baseOrder: Order = {
      id: orderId,
      userId: user ? user.uid : null,
      isGuest: isGuestOrder,
      customerEmail: formValues.email.trim(),
      customerName: formValues.name.trim(),
      items: cart.map((item) => ({
        productId: item.product.id,
        productName: item.product.name,
        price: Number(item.product.price) || 0,
        quantity: Number(item.quantity) || 1,
        color: item.selectedColor?.name || 'Estándar',
        size: item.selectedSize || 'Única',
        image: item.selectedColor?.imageUrl || item.product.images?.[0] || ''
      })),
      subtotal: finalTotals.subtotal,
      volumeDiscount: volumeDiscount > 0 ? volumeDiscount : 0,
      discount: cartDiscount,
      shipping: finalTotals.shippingCost,
      total: finalTotals.total,
      status: 'pending_payment',
      paymentMethod: selectedPaymentMethod === 'bizum' ? 'hilow_bizum' : 'hilow_card',
      shippingAddress: {
        street: formValues.street.trim(),
        city: formValues.city.trim(),
        state: formValues.state.trim(),
        postalCode: formValues.postalCode.trim(),
        country: formValues.country.trim(),
        phone: formValues.phone.trim()
      },
      ...(selectedQuote
        ? {
            packlink: {
              serviceId: selectedQuote.serviceId,
              serviceName: selectedQuote.serviceName,
              carrierName: selectedQuote.carrierName,
              quotedPrice: selectedQuote.price,
              currency: selectedQuote.currency,
              status: 'quoted'
            }
          }
        : {}),
      ...(appliedPromo?.code ? { promoCodeApplied: appliedPromo.code } : {}),
      loyaltyPointsEarned: user ? finalTotals.estimatedPoints : 0,
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString()
    };

    try {
      const productSummary =
        cart
          .map((i) => `${i.quantity}x ${i.product.name}`)
          .join(', ')
          .slice(0, 75) || "Pedido Chloe's Secrets World";

      // 1. Recalcular importes en el servidor y crear sesión de pago autoritativa
      const session = await createHilowPaymentSession({
        internalOrderId: orderId,
        amountInCents: finalTotals.priceInCents,
        productName: productSummary,
        isSubscription: false,
        storeUrl: window.location.origin,
        customerEmail: baseOrder.customerEmail,
        items: cart.map((item) => ({
          productId: item.product.id,
          quantity: Number(item.quantity) || 1,
          color: item.selectedColor?.name || 'Estándar',
          size: item.selectedSize || 'Única'
        })),
        promoCode: appliedPromo?.code,
        shippingAddress: {
          postalCode: formValues.postalCode.trim(),
          country: formValues.country.trim()
        },
        selectedServiceId: selectedQuote?.serviceId
      });

      const resolvedCheckoutUrl = session.checkoutUrl || session.paymentUrl;
      if (!session.success || !resolvedCheckoutUrl) {
        throw new Error(
          session.message || session.error || 'La pasarela de pago no devolvió una sesión activa.'
        );
      }

      // 2. Aplicar precios, envío, cupón y puntos verificados por el servidor al pedido
      const serverPricing = session.pricing;
      const verifiedTotal = serverPricing ? serverPricing.total : baseOrder.total;
      const verifiedOrder: Order = {
        ...baseOrder,
        ...(serverPricing
          ? {
              items: serverPricing.items.map((srvLine, idx) => ({
                ...srvLine,
                image: srvLine.image || baseOrder.items[idx]?.image || ''
              })),
              subtotal: serverPricing.subtotal,
              volumeDiscount: serverPricing.volumeDiscount,
              discount: serverPricing.discount,
              shipping: serverPricing.shipping,
              total: serverPricing.total,
              ...(serverPricing.appliedPromoCode
                ? { promoCodeApplied: serverPricing.appliedPromoCode }
                : {}),
              ...(serverPricing.verifiedQuote
                ? {
                    packlink: {
                      serviceId: serverPricing.verifiedQuote.serviceId,
                      serviceName: serverPricing.verifiedQuote.serviceName,
                      carrierName: serverPricing.verifiedQuote.carrierName,
                      quotedPrice: serverPricing.verifiedQuote.price,
                      currency: serverPricing.verifiedQuote.currency,
                      status: 'quoted'
                    }
                  }
                : {}),
              loyaltyPointsEarned: user ? Math.max(1, Math.floor(verifiedTotal)) : 0
            }
          : {})
      };

      // 3. Registrar el pedido verificado en Cloud Firestore antes de abrir el pago
      try {
        await addOrder(verifiedOrder);
      } catch (localErr: any) {
        const rawMsg = localErr?.message || String(localErr);
        setPaymentErrorKind('local');
        setPaymentError(
          'No se pudo registrar el pedido verificado en la base de datos. Verifica tu conexión e inténtalo de nuevo.'
        );
        console.error('[Checkout Local Order Error]:', rawMsg);
        return;
      }

      const activeMethod = selectedPaymentMethod === 'bizum' ? 'hilow_bizum' : 'hilow_card';
      setContextPaymentMethod(activeMethod);
      setCheckoutData({
        orderId,
        paymentMethod: activeMethod,
        orderSummary: verifiedOrder
      });

      setHilowSession({
        isOpen: true,
        orderId,
        amountInCents: serverPricing?.amountInCents || finalTotals.priceInCents,
        productName: productSummary,
        customerEmail: verifiedOrder.customerEmail,
        paymentUrl: resolvedCheckoutUrl,
        orderObj: verifiedOrder
      });
    } catch (err: any) {
      const msg = err?.message || 'Error al iniciar el pago con tarjeta / Bizum.';
      setPaymentErrorKind('gateway');
      setPaymentError(msg);
      showToast('error', 'Error en la pasarela de pago', msg);
    } finally {
      setSubmittingOrder(false);
    }
  };

  // Called when HilowCheckoutModal confirms HMAC webhook payment
  const handlePaymentVerified = async (orderObj: Order) => {
    setHilowSession(null);

    if (user && orderObj.loyaltyPointsEarned && orderObj.loyaltyPointsEarned > 0) {
      try {
        // Check if server-side webhook already marked order as paid and incremented points
        let alreadyCreditedByWebhook = false;
        try {
          const snap = await getDoc(doc(db, 'orders', orderObj.id));
          if (snap.exists() && snap.data()?.status === 'paid' && snap.data()?.paidAt) {
            alreadyCreditedByWebhook = true;
          }
        } catch {
          // Proceed with client fallback if read fails
        }

        if (!alreadyCreditedByWebhook) {
          const currentPoints = userProfile?.loyaltyPoints || 0;
          await updateUserProfile({
            loyaltyPoints: currentPoints + orderObj.loyaltyPointsEarned
          });
        }
      } catch (ptsErr) {
        console.warn('No se pudieron actualizar los puntos VIP:', ptsErr);
      }
    }

    clearCheckoutData();
    setCompletedOrder({
      ...orderObj,
      status: 'paid'
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  if (isAuthLoading && !user) {
    return (
      <div className="min-h-[60vh] flex flex-col items-center justify-center gap-3">
        <Loader2 className="w-8 h-8 animate-spin text-teal-800" />
        <p className="text-xs text-neutral-500">Cargando entorno seguro de compra...</p>
      </div>
    );
  }

  // POST-ORDER CONFIRMATION RECEIPT VIEW
  if (completedOrder) {
