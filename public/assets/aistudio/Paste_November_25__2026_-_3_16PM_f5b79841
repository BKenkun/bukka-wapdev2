            </h1>
            <p className="text-sm text-neutral-600 mt-2 max-w-lg mx-auto leading-relaxed">
              Tu pago ha sido verificado y hemos enviado el comprobante detallado a{' '}
              <strong className="text-neutral-900">{completedOrder.customerEmail}</strong>.
            </p>
          </div>

          <div className="py-6 grid grid-cols-1 sm:grid-cols-3 gap-4 border-b border-neutral-100 text-xs">
            <div>
              <span className="text-neutral-400 block mb-0.5">Número de Pedido</span>
              <strong className="font-mono text-neutral-900 text-sm">#{completedOrder.id}</strong>
            </div>
            <div>
              <span className="text-neutral-400 block mb-0.5">Destino Discreto</span>
              <strong className="text-neutral-900">
                {completedOrder.shippingAddress.city} ({completedOrder.shippingAddress.postalCode}),{' '}
                {completedOrder.shippingAddress.country}
              </strong>
            </div>
            <div>
              <span className="text-neutral-400 block mb-0.5">Estado del Pago</span>
              <strong className="text-emerald-700">Pagado y Verificado</strong>
            </div>
          </div>

          <div className="py-6 space-y-3 border-b border-neutral-100">
            <h2 className="text-xs font-bold uppercase tracking-wider text-neutral-700">
              Resumen de Prendas Adquiridas
            </h2>
            {completedOrder.items.map((item, idx) => (
              <div key={idx} className="flex items-center justify-between gap-4 text-xs py-1.5">
                <div className="flex items-center gap-3 min-w-0">
                  {item.image ? (
                    <img
                      src={item.image}
                      alt={item.productName}
                      referrerPolicy="no-referrer"
                      className="w-12 h-16 object-cover border border-neutral-200 shrink-0"
                    />
                  ) : (
                    <div className="w-12 h-16 bg-neutral-900 text-amber-300 flex items-center justify-center font-serif font-bold text-xs shrink-0">
                      CS
                    </div>
                  )}
                  <div className="min-w-0">
                    <p className="font-semibold text-neutral-900 truncate">{item.productName}</p>
                    <p className="text-neutral-500 mt-0.5">
                      Color: {item.color} · Talla: {item.size} · Cant.: {item.quantity}
                    </p>
                  </div>
                </div>
                <span className="font-mono font-semibold text-neutral-900 tabular-nums shrink-0">
                  {formatPrice(item.price * item.quantity)}
                </span>
              </div>
            ))}
          </div>

          <div className="py-5 space-y-2 text-xs border-b border-neutral-100 tabular-nums">
            <div className="flex justify-between text-neutral-600">
              <span>{t('Subtotal')}</span>
              <span>{formatPrice(completedOrder.subtotal)}</span>
            </div>
            {(completedOrder.volumeDiscount || 0) > 0 && (
              <div className="flex justify-between text-rose-700">
                <span>{t('Descuento Pack Volumen')}</span>
                <span>-{formatPrice(completedOrder.volumeDiscount || 0)}</span>
              </div>
            )}
            {completedOrder.discount > 0 && (
              <div className="flex justify-between text-rose-700">
                <span>
                  {t('Descuento Cupón')}{' '}
                  {completedOrder.promoCodeApplied ? `(${completedOrder.promoCodeApplied})` : ''}
                </span>
                <span>-{formatPrice(completedOrder.discount)}</span>
              </div>
            )}
            <div className="flex justify-between text-neutral-600">
              <span>
                {t('Envío Discreto')}
                {completedOrder.packlink ? ` · ${completedOrder.packlink.carrierName}` : ''}
              </span>
              <span>
                {completedOrder.shipping === 0 ? t('Gratis') : formatPrice(completedOrder.shipping)}
              </span>
            </div>
            <div className="flex justify-between text-base font-bold text-neutral-900 pt-2 border-t border-neutral-200">
              <span>{t('Total Pagado')}</span>
              <span className="font-mono">{formatPrice(completedOrder.total)}</span>
            </div>
            {currency !== 'EUR' && (
              <p className="text-[11px] text-neutral-400 text-right">
                {t('Liquidado en EUR')}: {formatEur(completedOrder.total)}
              </p>
            )}
          </div>

          {user && (completedOrder.loyaltyPointsEarned || 0) > 0 && (
            <div className="mt-5 p-3.5 bg-teal-50/70 border border-teal-200 text-xs text-teal-900 flex items-center gap-2.5">
              <Sparkles className="w-4 h-4 text-teal-700 shrink-0" />
              <span>
                Has sumado <strong>+{completedOrder.loyaltyPointsEarned} puntos VIP</strong> en tu
                cuenta de Chloe&apos;s Secrets World.
              </span>
            </div>
          )}

          <div className="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
            {user && (
              <button
                type="button"
                onClick={() => setIsAccountModalOpen(true)}
                className="px-6 py-3 border border-neutral-300 hover:border-neutral-900 text-neutral-900 text-xs font-semibold uppercase tracking-wider transition-colors cursor-pointer whitespace-nowrap"
              >
                Ver en Mis Pedidos
              </button>
            )}
            <button
              type="button"
              onClick={() => {
                setCompletedOrder(null);
                setCurrentView('catalog');
              }}
              className="px-6 py-3 bg-neutral-900 hover:bg-[#0f2d27] text-white text-xs font-semibold uppercase tracking-wider transition-colors cursor-pointer whitespace-nowrap"
            >
              Seguir Explorando Colección
            </button>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="max-w-4xl mx-auto px-4 sm:px-6 py-10 animate-fadeIn">
      <div className="text-center mb-8">
        <button
          type="button"
          onClick={() => setCurrentView('catalog')}
          className="inline-flex items-center gap-1.5 text-xs text-neutral-500 hover:text-neutral-900 mb-3 transition-colors cursor-pointer"
        >
          <ArrowLeft className="w-3.5 h-3.5" />
          <span>Volver a la tienda</span>
        </button>
        <h1 className="font-serif text-3xl sm:text-4xl text-neutral-900 font-bold">
          Finalizar Compra Segura
        </h1>
        <p className="text-xs text-neutral-500 mt-1.5">
          Embalaje neutro sin logotipos exteriores · Cifrado bancario SSL 256-bit
        </p>
      </div>

      <Stepper currentStep={step} onSelectStep={goToStep} />

      {/* Inline Toast / Notification Banner */}
      {noticeBanner && (
        <div
          className={`mb-6 p-4 border text-xs flex items-start justify-between gap-3 ${
            noticeBanner.type === 'success'
              ? 'bg-teal-50/80 border-teal-200 text-teal-950'
              : noticeBanner.type === 'error'
              ? 'bg-rose-50 border-rose-200 text-rose-900'
              : 'bg-neutral-50 border-neutral-200 text-neutral-800'
          }`}
        >
          <div className="flex items-start gap-2.5">
            {noticeBanner.type === 'success' ? (
              <CheckCircle2 className="w-4 h-4 text-teal-700 shrink-0 mt-0.5" />
            ) : noticeBanner.type === 'error' ? (
              <AlertTriangle className="w-4 h-4 text-rose-600 shrink-0 mt-0.5" />
            ) : (
              <Info className="w-4 h-4 text-neutral-600 shrink-0 mt-0.5" />
            )}
            <div>
              <p className="font-bold">{noticeBanner.title}</p>
              <p className="mt-0.5 opacity-90">{noticeBanner.message}</p>
            </div>
          </div>
          <button
            type="button"
            onClick={() => setNoticeBanner(null)}
            className="text-current opacity-60 hover:opacity-100 p-0.5 cursor-pointer"
            aria-label="Cerrar aviso"
          >
            <X className="w-4 h-4" />
          </button>
        </div>
      )}

      {/* Payment Error Banner outside Step 3 */}
      {paymentError && step !== 3 && (
        <div className="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-900 text-xs space-y-2">
          <div className="flex items-center gap-2 font-bold">
            <AlertTriangle className="w-4 h-4 text-rose-600 shrink-0" />
            <span>
              {paymentErrorKind === 'local'
                ? 'Error al registrar el pedido'
                : 'Incidencia en la pasarela de pago'}
            </span>
          </div>
          <p>{paymentError}</p>
          <button
            type="button"
            onClick={() => {
              setPaymentError(null);
              setPaymentErrorKind(null);
            }}
            className="px-3 py-1.5 border border-rose-300 text-rose-800 hover:bg-rose-100 font-semibold cursor-pointer"
          >
            Descartar aviso
          </button>
        </div>
      )}

      {/* ================================================================= */}
      {/* PASO 1: CONFIRMACIÓN DE BOLSA DE COMPRA                           */}
      {/* ================================================================= */}
      {step === 1 && (
        <div className="bg-white border border-neutral-200 shadow-xs">
          <div className="p-6 border-b border-neutral-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h2 className="font-serif text-xl font-bold text-neutral-900">
                1. Confirma las Prendas de tu Bolsa
              </h2>
              <p className="text-xs text-neutral-500 mt-0.5">
                Revisa tallas, colores y unidades antes de indicar los datos de entrega.
              </p>
            </div>
            <span className="text-xs text-neutral-500 tabular-nums">
              {totalUnits} {totalUnits === 1 ? 'artículo seleccionado' : 'artículos seleccionados'}
            </span>
          </div>

          {/* Free Shipping & Volume Discount Bar */}
          {cart.length > 0 && (
            <div className="px-6 py-3 bg-[#f0fdfa] border-b border-teal-100 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div className="flex items-center gap-2 text-teal-950">
                <Truck className="w-4 h-4 text-teal-700 shrink-0" />
                {freeShippingRemaining > 0 ? (
                  <span>
                    {t('Te faltan')}{' '}
                    <strong className="tabular-nums">{formatPrice(freeShippingRemaining)}</strong>{' '}
                    {t('para conseguir')} <strong>{t('Envío Discreto Gratis')}</strong>.
                  </span>
                ) : (
                  <span className="font-semibold text-teal-900">
                    {t('¡Tienes Envío Estándar Gratis activado en este pedido!')}
                  </span>
                )}
              </div>
              <div className="text-neutral-600">
                {volumeDiscountPercent > 0 ? (
                  <span className="text-teal-800 font-semibold">
                    Pack Ahorro aplicado: -{volumeDiscountPercent}% dto. por volumen
                  </span>
                ) : (
                  <span>Añade 2 prendas para -5% dto. · 3+ prendas para -10% dto.</span>
                )}
              </div>
            </div>
          )}

          {cart.length === 0 ? (
            <div className="p-14 text-center space-y-4">
              <ShoppingBag className="w-12 h-12 text-neutral-300 mx-auto" />
              <h3 className="font-serif text-2xl text-neutral-800">Tu bolsa de compra está vacía</h3>
              <p className="text-xs text-neutral-500 max-w-sm mx-auto">
                Descubre nuestras colecciones de alta lencería, corsetería y prendas de descanso.
              </p>
              <button
                type="button"
                onClick={() => setCurrentView('catalog')}
                className="px-6 py-3 bg-neutral-900 hover:bg-teal-900 text-white text-xs font-semibold uppercase tracking-wider transition-colors cursor-pointer"
              >
                Explorar Catálogo
              </button>
            </div>
          ) : (
            <>
              <div className="divide-y divide-neutral-100 px-6">
                {cart.map((item) => {
                  const imgSrc = item.selectedColor?.imageUrl || item.product.images?.[0] || '';
                  const imgFailed = brokenImages[item.id] || !imgSrc;

                  return (
                    <div key={item.id} className="py-5 flex items-center gap-4">
                      <div className="w-20 h-26 shrink-0 border border-neutral-200 overflow-hidden bg-neutral-100">
                        {!imgFailed ? (
                          <img
                            src={imgSrc}
                            alt={item.product.name}
                            referrerPolicy="no-referrer"
                            onError={() =>
                              setBrokenImages((prev) => ({ ...prev, [item.id]: true }))
                            }
                            className="w-full h-full object-cover"
                          />
                        ) : (
                          <div className="w-full h-full bg-neutral-900 text-amber-300 flex items-center justify-center font-serif font-bold text-sm">
                            CS
                          </div>
                        )}
                      </div>

                      <div className="flex-1 min-w-0">
                        <h3 className="text-sm font-semibold text-neutral-900 truncate">
