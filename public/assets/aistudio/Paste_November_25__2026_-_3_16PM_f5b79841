                    {formatEur(finalTotals.total)}
                  </strong>
                </p>
              )}
            </div>

            {/* Step 3 Granular Validation / Gateway Error Panel */}
            {(payStepDetail || paymentError) && (
              <div className="p-4 bg-rose-50 border border-rose-200 text-rose-900 text-xs space-y-2.5">
                <div className="flex items-center gap-2 font-bold text-sm">
                  <AlertTriangle className="h-4 w-4 text-rose-600 shrink-0" />
                  <span>
                    {payStepDetail?.title ||
                      (paymentErrorKind === 'local'
                        ? 'Error al guardar el pedido'
                        : 'No se pudo iniciar la pasarela de pago')}
                  </span>
                </div>

                {payStepDetail && payStepDetail.items.length > 0 && (
                  <ul className="list-disc pl-5 space-y-1 text-rose-800">
                    {payStepDetail.items.map((line, i) => (
                      <li key={i}>{line}</li>
                    ))}
                  </ul>
                )}

                {paymentError && (
                  <div className="space-y-1">
                    <p className="font-medium break-words">{paymentError}</p>
                    <p className="text-rose-700">
                      {paymentErrorKind === 'local'
                        ? 'Comprueba tu conexión a internet. No se ha realizado ningún cargo.'
                        : 'Tu pedido ha quedado registrado sin cargo. Puedes reintentar la conexión con la pasarela.'}
                    </p>
                  </div>
                )}

                {payStepDetail?.hint && (
                  <p className="pt-2 border-t border-rose-200 text-rose-800">{payStepDetail.hint}</p>
                )}

                <button
                  type="button"
                  onClick={() => {
                    setPayStepDetail(null);
                    setPaymentError(null);
                    setPaymentErrorKind(null);
                  }}
                  className="px-3 py-1.5 border border-rose-300 bg-white hover:bg-rose-100 text-rose-900 font-semibold cursor-pointer"
                >
                  Ocultar detalle
                </button>
              </div>
            )}

            {/* Primary Pay Button */}
            <button
              type="button"
              disabled={submittingOrder || cart.length === 0}
              onClick={handleFinalSubmit}
              className="w-full py-4 px-6 bg-[#0f2d27] hover:bg-neutral-900 disabled:opacity-50 text-white text-sm font-bold uppercase tracking-widest transition-colors flex items-center justify-center gap-2.5 shadow-md cursor-pointer"
            >
              {submittingOrder ? (
                <>
                  <Loader2 className="w-5 h-5 animate-spin text-teal-300" />
                  <span>Conectando de forma segura...</span>
                </>
              ) : (
                <>
                  <Lock className="w-4 h-4 text-teal-300" />
                  <span>
                    {t('Pagar de Forma Segura')} · {formatPrice(finalTotals.total)}
                    {currency !== 'EUR' ? ` (${formatEur(finalTotals.total)})` : ''}
                  </span>
                </>
              )}
            </button>
          </div>
        </div>
      )}

      {/* STEP NAVIGATION BUTTONS */}
      <div className="mt-8 flex items-center justify-between gap-4">
        {step > 1 ? (
          <button
            type="button"
            onClick={() => goToStep(step - 1)}
            className="px-5 py-3 border border-neutral-300 bg-white hover:border-neutral-900 text-neutral-800 text-xs font-semibold uppercase tracking-wider flex items-center gap-2 transition-colors cursor-pointer whitespace-nowrap"
          >
            <ArrowLeft className="h-4 w-4" />
            <span>Paso Anterior</span>
          </button>
        ) : (
          <div />
        )}

        {step === 1 && cart.length > 0 && (
          <button
            type="button"
            onClick={handleContinueFromStep1}
            className="px-7 py-3.5 bg-neutral-900 hover:bg-[#0f2d27] text-white text-xs font-bold uppercase tracking-wider flex items-center gap-2 transition-colors cursor-pointer whitespace-nowrap"
          >
            <span>Continuar con mis Datos</span>
            <ArrowRight className="h-4 w-4" />
          </button>
        )}

        {step === 2 && (
          <button
            type="button"
            onClick={handleContinueFromStep2}
            disabled={packlinkLoading || registerLoading}
            className="px-7 py-3.5 bg-neutral-900 hover:bg-[#0f2d27] disabled:opacity-50 text-white text-xs font-bold uppercase tracking-wider flex items-center gap-2 transition-colors cursor-pointer whitespace-nowrap"
          >
            {packlinkLoading || registerLoading ? (
              <>
                <Loader2 className="h-4 w-4 animate-spin text-teal-300" />
                <span>
                  {registerLoading ? 'Creando tu cuenta VIP...' : 'Calculando tarifa de envío...'}
                </span>
              </>
            ) : (
              <>
                <span>
                  {user
                    ? 'Continuar al Pago'
                    : checkoutMode === 'register'
                    ? 'Crear Cuenta y Continuar al Pago'
                    : checkoutMode === 'guest'
                    ? 'Continuar como Invitado al Pago'
                    : 'Continuar'}
                </span>
                <ArrowRight className="h-4 w-4" />
              </>
            )}
          </button>
        )}
      </div>

      {/* Hilow Gateway Modal */}
      {hilowSession && (
        <HilowCheckoutModal
          isOpen={hilowSession.isOpen}
          onClose={() => setHilowSession(null)}
          orderId={hilowSession.orderId}
          amountInCents={hilowSession.amountInCents}
          productName={hilowSession.productName}
          customerEmail={hilowSession.customerEmail}
          paymentUrl={hilowSession.paymentUrl}
          initialMethod={selectedPaymentMethod}
          onSuccess={() => handlePaymentVerified(hilowSession.orderObj)}
        />
      )}
    </div>
  );
};
