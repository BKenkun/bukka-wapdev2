function decodeFirestoreDoc(rawDoc: any): Record<string, any> | null {
  if (!rawDoc || typeof rawDoc !== 'object' || !rawDoc.fields) return null;
  const out: Record<string, any> = {};
  for (const [k, v] of Object.entries(rawDoc.fields)) {
    out[k] = fromFirestoreRestValue(v as Record<string, any>);
  }
  return out;
}

function getFirestoreBaseUrl(): string {
  return `https://firestore.googleapis.com/v1/projects/${encodeURIComponent(
    projectId
  )}/databases/${encodeURIComponent(databaseId)}/documents`;
}

async function fetchPublicDocServer(collectionName: string, docId: string): Promise<Record<string, any> | null> {
  const adminRes = await runWithAdminFirestore(async (adminDb) => {
    const snap = await adminDb.collection(collectionName).doc(docId).get();
    return snap.exists ? ({ id: snap.id, ...snap.data() } as Record<string, any>) : null;
  }, `read-${collectionName}`);

  if (adminRes.available) {
    return adminRes.result;
  }

  const url = `${getFirestoreBaseUrl()}/${encodeURIComponent(collectionName)}/${encodeURIComponent(docId)}`;
  const resp = await fetch(url).catch(() => null);
  if (!resp || !resp.ok) return null;
  const raw = await resp.json().catch(() => null);
  const decoded = decodeFirestoreDoc(raw);
  if (!decoded) return null;
  return { id: docId, ...decoded };
}

async function fetchAllPromoCodesServer(): Promise<Array<Record<string, any>>> {
  const adminRes = await runWithAdminFirestore(async (adminDb) => {
    const snap = await adminDb.collection('promoCodes').get();
    return snap.docs.map((d) => ({ id: d.id, ...d.data() }) as Record<string, any>);
  }, 'read-promoCodes');

  if (adminRes.available) {
    return adminRes.result.length > 0 ? adminRes.result : INITIAL_PROMO_CODES;
  }

  const url = `${getFirestoreBaseUrl()}/promoCodes?pageSize=200`;
  const resp = await fetch(url).catch(() => null);
  if (resp && resp.ok) {
    const json: any = await resp.json().catch(() => null);
    const docs = Array.isArray(json?.documents) ? json.documents : [];
    const parsed = docs
      .map((d: any) => {
        const decoded = decodeFirestoreDoc(d);
        if (!decoded) return null;
        const nameParts = String(d.name || '').split('/');
        return { id: nameParts[nameParts.length - 1] || decoded.id, ...decoded };
      })
      .filter(Boolean) as Array<Record<string, any>>;
    if (parsed.length > 0) return parsed;
  }

  return INITIAL_PROMO_CODES;
}

function round2(n: number): number {
  return Number((Number(n) || 0).toFixed(2));
}

export class CheckoutPricingError extends Error {
  statusCode: number;
  constructor(message: string, statusCode = 400) {
    super(message);
    this.statusCode = statusCode;
  }
}

/**
 * Recalculates authoritative cart prices, discounts, shipping, and total in cents
 * strictly from Firestore catalog/settings/shipping rules on the server.
 */
export async function calculateServerOrderTotals(params: {
  items: ServerCheckoutItemInput[];
  promoCode?: string;
  shippingAddress?: { postalCode?: string; country?: string };
  selectedServiceId?: string;
}): Promise<ServerPricingSummary> {
  const rawItems = Array.isArray(params.items) ? params.items : [];
  if (rawItems.length === 0 || rawItems.length > 50) {
    throw new CheckoutPricingError('El carrito está vacío o supera el máximo permitido.');
  }

  // Deduplicate reads for identical productIds
  const uniqueProductIds = Array.from(
    new Set(
      rawItems
        .map((i) => String(i?.productId || '').trim())
        .filter((id) => /^[a-zA-Z0-9_-]{1,128}$/.test(id))
    )
  );

  if (uniqueProductIds.length === 0) {
    throw new CheckoutPricingError('Los artículos del carrito no tienen identificadores válidos.');
  }

  const [siteDoc, ...fetchedProducts] = await Promise.all([
    fetchPublicDocServer('appSettings', 'site'),
    ...uniqueProductIds.map((id) => fetchPublicDocServer('products', id))
  ]);

  const productById = new Map<string, Record<string, any>>();
  uniqueProductIds.forEach((id, idx) => {
    const docData = fetchedProducts[idx];
    if (docData) {
      productById.set(id, docData);
    }
  });

  const nowMs = Date.now();
  const verifiedLines: ServerVerifiedOrderLine[] = [];
  let subtotal = 0;
  let totalUnits = 0;

  for (const rawLine of rawItems) {
    const productId = String(rawLine?.productId || '').trim();
    const qty = Math.floor(Number(rawLine?.quantity));
    if (!productId || !Number.isFinite(qty) || qty < 1 || qty > 50) {
      throw new CheckoutPricingError('Cantidad o artículo no válido en el carrito.');
    }

    const product = productById.get(productId);
    if (!product) {
      throw new CheckoutPricingError(
        `Uno de los artículos de tu bolsa ya no está disponible en el catálogo (${productId}).`,
        404
      );
    }

    const allowPreorder = Boolean(product.allowPreorder);
    const availStatus = String(product.availabilityStatus || 'available');
    const cooldownMs = product.cooldownUntil ? new Date(String(product.cooldownUntil)).getTime() : NaN;
    const isInActiveCooldown =
      availStatus === 'cooldown' && (!Number.isFinite(cooldownMs) || cooldownMs > nowMs);

    if (
      availStatus === 'sold_out' ||
      availStatus === 'reserved' ||
      (isInActiveCooldown && !allowPreorder) ||
      (product.inStock === false && !allowPreorder && availStatus !== 'in_production')
    ) {
      throw new CheckoutPricingError(
        `La prenda "${product.name || productId}" se encuentra reservada o en periodo de reposición temporal.`,
        409
      );
    }

    const unitPrice = round2(Number(product.price));
    if (!Number.isFinite(unitPrice) || unitPrice <= 0) {
      throw new CheckoutPricingError(`Precio inválido para "${product.name || productId}".`, 400);
    }

    subtotal = round2(subtotal + unitPrice * qty);
    totalUnits += qty;

    const firstImg = Array.isArray(product.images) && product.images.length > 0 ? String(product.images[0]) : '';
    verifiedLines.push({
      productId,
      productName: String(product.name || 'Prenda Exclusiva').slice(0, 150),
      price: unitPrice,
      quantity: qty,
      color: String(rawLine.color || 'Estándar').slice(0, 64),
      size: String(rawLine.size || 'Única').slice(0, 32),
      image: firstImg,
      ...(product.creatorId ? { creatorId: String(product.creatorId) } : {}),
      ...(Array.isArray(product.modelIds) ? { modelNames: product.modelIds.map(String) } : {}),
      editionTier: product.editionTier === 'signature' ? 'signature' : 'standard'
    });
  }

  // Site product rules (volume discount + free shipping threshold + flat rate)
  const productCfg = (siteDoc?.siteConfig?.product || DEFAULT_SITE_CONFIG.product) as Record<string, any>;
  const enableVolume = productCfg.enableVolumeDiscounts ?? true;
  const volumeDiscountPercent = enableVolume ? (totalUnits >= 3 ? 10 : totalUnits === 2 ? 5 : 0) : 0;
  const volumeDiscount = round2((subtotal * volumeDiscountPercent) / 100);
  const subtotalAfterVolume = Math.max(0, round2(subtotal - volumeDiscount));

  // Authoritative promo code check
  let discount = 0;
  let appliedPromoCode: string | undefined;
  let isFreeShippingPromo = false;

  const cleanCode = String(params.promoCode || '').trim().toUpperCase();
  if (cleanCode) {
    const promos = await fetchAllPromoCodesServer();
    const matched = promos.find(
      (p) => String(p.code || '').trim().toUpperCase() === cleanCode && Boolean(p.active)
    );
    if (!matched) {
      throw new CheckoutPricingError(`El cupón ${cleanCode} no es válido o ya no está activo.`, 400);
    }
    const maxUses = Number(matched.maxUses) || 0;
    const usesCount = Number(matched.usesCount) || 0;
    if (maxUses > 0 && usesCount >= maxUses) {
      throw new CheckoutPricingError(`El cupón ${cleanCode} ha alcanzado su límite máximo de usos.`, 400);
    }
    if (matched.validUntil) {
      const expDate = new Date(String(matched.validUntil));
      if (!Number.isNaN(expDate.getTime()) && expDate.getTime() < nowMs - 86400000) {
        throw new CheckoutPricingError(`El cupón ${cleanCode} ha expirado.`, 400);
      }
    }
    const minOrderAmount = Number(matched.minOrderAmount) || 0;
    if (minOrderAmount > 0 && subtotal < minOrderAmount) {
      throw new CheckoutPricingError(
        `El cupón ${cleanCode} requiere un pedido mínimo de ${minOrderAmount.toFixed(2)} €.`,
        400
      );
    }

    appliedPromoCode = String(matched.code).trim().toUpperCase();
    const dType = String(matched.discountType || '');
    const dVal = Number(matched.discountValue) || 0;
    if (dType === 'free_shipping') {
      isFreeShippingPromo = true;
    } else if ((dType === 'percent' || dType === 'percentage') && dVal > 0) {
      discount = round2((subtotalAfterVolume * Math.min(100, dVal)) / 100);
    } else if (dType === 'fixed' && dVal > 0) {
      discount = round2(Math.min(subtotalAfterVolume, dVal));
    }
  }

  const subtotalAfterAllDiscounts = round2(Math.max(0, subtotalAfterVolume - discount));
  const freeShippingThreshold = Number(productCfg.freeShippingThreshold ?? 40.0);
  const flatShippingRate = Number(productCfg.flatShippingRate ?? 5.99);
  const qualifiesForFreeStandard = subtotalAfterAllDiscounts >= freeShippingThreshold || isFreeShippingPromo;

  let shipping = 0;
  let verifiedQuote: ServerShippingQuote | undefined;

  const postalCode = String(params.shippingAddress?.postalCode || '').trim();
  const country = String(params.shippingAddress?.country || '').trim();

  if (postalCode && country) {
    const { quotes } = await getServerShippingQuotes({ postalCode, country });
    const cheapest = quotes[0];
    const requestedId = String(params.selectedServiceId || '').trim();
    const chosen = requestedId ? quotes.find((q) => q.serviceId === requestedId) || cheapest : cheapest;
    verifiedQuote = chosen;

    if (qualifiesForFreeStandard && chosen.serviceId === cheapest.serviceId) {
      shipping = 0;
    } else {
      shipping = round2(chosen.price);
    }
  } else {
    shipping = qualifiesForFreeStandard ? 0 : round2(flatShippingRate);
  }

  const total = round2(Math.max(0, subtotalAfterAllDiscounts + shipping));
  const amountInCents = Math.round(total * 100);
  if (!Number.isFinite(amountInCents) || amountInCents <= 0) {
    throw new CheckoutPricingError('El importe calculado del pedido no es válido.', 400);
  }

  return {
    items: verifiedLines,
    subtotal,
    volumeDiscount,
    volumeDiscountPercent,
    discount,
    shipping,
    total,
    amountInCents,
    ...(appliedPromoCode ? { appliedPromoCode } : {}),
    isFreeShippingPromo,
    ...(verifiedQuote ? { verifiedQuote } : {})
  };
}

export const DEFAULT_SUBSCRIPTION_PRICE_EUR = 44;
export const DEFAULT_SUBSCRIPTION_PLAN_NAME = "Club Privé Chloe's Secrets (Suscripción Mensual)";

/**
 * Reads the admin-configured monthly subscription price & plan name from Firestore (appSettings/site)
 * and clamps it to a safe authoritative EUR amount on the server.
 */
export async function getAuthoritativeSubscriptionConfig(): Promise<{
  priceEur: number;
  amountInCents: number;
  planName: string;
}> {
  const siteDoc = await fetchPublicDocServer('appSettings', 'site').catch(() => null);
  const productCfg = (siteDoc?.siteConfig?.product || DEFAULT_SITE_CONFIG.product) as Record<
    string,
    any
  >;

  const rawPrice = Number(productCfg.subscriptionMonthlyPrice);
  const priceEur =
    Number.isFinite(rawPrice) && rawPrice >= 1 && rawPrice <= 5000
      ? round2(rawPrice)
      : DEFAULT_SUBSCRIPTION_PRICE_EUR;

  const amountInCents = Math.max(100, Math.round(priceEur * 100));
  const rawName = typeof productCfg.subscriptionPlanName === 'string' ? productCfg.subscriptionPlanName.trim() : '';
  const planName = rawName ? rawName.slice(0, 120) : DEFAULT_SUBSCRIPTION_PLAN_NAME;

  return {
    priceEur,
    amountInCents,
    planName
  };
}
