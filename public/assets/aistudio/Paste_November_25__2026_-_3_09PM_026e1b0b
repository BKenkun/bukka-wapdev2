  MEXICO: 'MX',
  'MÉXICO': 'MX'
};

export function normalizeCountryToIso(rawCountry?: string): string | null {
  const clean = String(rawCountry || '').trim().toUpperCase();
  return COUNTRY_ISO_MAP[clean] || (/^[A-Z]{2}$/.test(clean) ? clean : null);
}

function formatTransitHours(rawHours: unknown): string {
  const hrs = Number(rawHours);
  if (!Number.isFinite(hrs) || hrs <= 0) return '24-72h';
  if (hrs <= 24) return '24h laborables';
  if (hrs <= 48) return '24-48h';
  if (hrs <= 72) return '48-72h';
  const days = Math.max(2, Math.ceil(hrs / 24));
  return `${days - 1}-${days} días laborables`;
}

/**
 * Single authoritative shipping rate calculator (Packlink PRO live API + deterministic zonal fallback).
 */
export async function getServerShippingQuotes(params: {
  postalCode: string;
  country: string;
  maxOptionsOverride?: number;
  ignoreCarrierFilter?: boolean;
}): Promise<{
  isoCountry: string;
  quotes: ServerShippingQuote[];
  source: 'packlink_live' | 'zonal_fallback';
  originCountry: string;
  originPostalCode: string;
  totalPacklinkCandidates?: number;
}> {
  const cleanPostal = String(params.postalCode || '').trim();
  const isoCountry = normalizeCountryToIso(params.country);

  if (!cleanPostal || cleanPostal.length < 3) {
    throw new Error('Introduce un código postal válido para calcular el envío.');
  }
  if (!isoCountry) {
    throw new Error(
      'Introduce el país de entrega o su código ISO de 2 letras (ej. España, ES, Portugal, Francia).'
    );
  }
  if (isoCountry === 'ES' && !/^\d{5}$/.test(cleanPostal)) {
    throw new Error('Para envíos en España, el código postal debe tener 5 dígitos (ej. 28001).');
  }

  const origin = await readPacklinkSettings();
  const maxOptions = Number.isFinite(params.maxOptionsOverride)
    ? Math.min(12, Math.max(2, Number(params.maxOptionsOverride)))
    : Math.min(8, Math.max(2, Number(origin.maxOptionsShown) || 5));

  const homeDeliveryOnly = origin.homeDeliveryOnly ?? true;
  const excludeSenderDropoff = origin.excludeSenderDropoff ?? false;
  const allowedCarriersNormalized = !params.ignoreCarrierFilter && Array.isArray(origin.allowedCarriers)
    ? origin.allowedCarriers.map((c) => c.trim().toLowerCase()).filter(Boolean)
    : [];

  const packlinkApiKey = process.env.PACKLINK_API_KEY?.trim();
  if (packlinkApiKey) {
    try {
      const queryParams = new URLSearchParams({
        'from[country]': origin.country || 'ES',
        'from[zip]': origin.postalCode || '28001',
        'to[country]': isoCountry,
        'to[zip]': cleanPostal,
        'packages[0][weight]': String(origin.weightKg || 0.5),
        'packages[0][length]': String(origin.lengthCm || 28),
        'packages[0][width]': String(origin.widthCm || 20),
        'packages[0][height]': String(origin.heightCm || 6)
      });
      const plResp = await fetch(`https://api.packlink.com/v1/services?${queryParams.toString()}`, {
        headers: {
          Authorization: packlinkApiKey,
          Accept: 'application/json',
          'Content-Type': 'application/json'
        }
      });
      if (plResp.ok) {
        const plData = await plResp.json();
        const rawList = Array.isArray(plData)
          ? plData
          : Array.isArray(plData?.services)
          ? plData.services
          : [];

        if (rawList.length > 0) {
          const allNormalized: ServerShippingQuote[] = rawList
            .map((s: any): ServerShippingQuote => {
              const serviceName = String(s.name || s.service_name || 'Mensajería con Seguimiento').trim();
              const nameLc = serviceName.toLowerCase();
              const isLockerOrOfficeDest =
                nameLc.includes('-oficina') ||
                nameLc.includes('en oficina') ||
                nameLc.includes('parcelshop') ||
                nameLc.includes('punto pack') ||
                nameLc.includes('citypaq') ||
                nameLc.includes('locker') ||
                nameLc.includes('servicepoint');
              const requiresDropoff = Boolean(
                s.delivery_to_parcelshop ?? s.requiresDropoffPoint ?? isLockerOrOfficeDest
              );
              const senderDropoff = Boolean(
                s.dropoff ?? (nameLc.startsWith('oficina-') || nameLc.includes('oficina-oficina'))
              );
              const rawPrice = Number(
                s.price?.total_price ?? s.total_price ?? s.price?.base_price ?? s.base_price
              );
              return {
                serviceId: String(s.id ?? s.service_id ?? ''),
                serviceName,
                carrierName: String(s.carrier_name || s.carrier || 'Packlink Courier').trim(),
                price: Number.isFinite(rawPrice) ? Number(rawPrice.toFixed(2)) : 0,
                currency: String(s.currency || s.price?.currency || 'EUR'),
                transitDays: formatTransitHours(s.transit_hours),
                category: String(s.category || 'standard').toLowerCase(),
                homeDelivery: !requiresDropoff,
                requiresDropoffPoint: requiresDropoff,
                senderDropoff,
                printerRequired: s.printer_needed !== undefined ? Boolean(s.printer_needed) : true,
                trackingIncluded: true,
                isZonalFallback: false
              };
            })
            .filter((q: ServerShippingQuote) => Boolean(q.serviceId && Number.isFinite(q.price) && q.price > 0));

          let eligible = allNormalized.filter((q) => {
            if (homeDeliveryOnly && q.requiresDropoffPoint) return false;
            if (excludeSenderDropoff && q.senderDropoff) return false;
            if (allowedCarriersNormalized.length > 0) {
              const lcCarrier = q.carrierName.toLowerCase();
              if (!allowedCarriersNormalized.some((allowed) => lcCarrier.includes(allowed))) {
                return false;
              }
            }
            return true;
          });

          // If strict carrier filter excluded everything, relax carrier whitelist while keeping delivery safety
          if (eligible.length === 0 && allowedCarriersNormalized.length > 0) {
            eligible = allNormalized.filter(
              (q) =>
                (!homeDeliveryOnly || !q.requiresDropoffPoint) &&
                (!excludeSenderDropoff || !q.senderDropoff)
            );
          }

          eligible.sort((a, b) => a.price - b.price);

          // Deduplicate identical carrier + service name variants keeping cheapest first,
          // and select diverse carrier options up to `maxOptions`
          const seenKeys = new Set<string>();
          const curated: ServerShippingQuote[] = [];
          for (const q of eligible) {
            const key = `${q.carrierName.toLowerCase()}::${q.serviceName.toLowerCase()}`;
            if (seenKeys.has(key)) continue;
            seenKeys.add(key);
            curated.push(q);
            if (curated.length >= maxOptions) break;
          }

          if (curated.length > 0) {
            return {
              isoCountry,
              quotes: curated,
              source: 'packlink_live',
              originCountry: origin.country || 'ES',
              originPostalCode: origin.postalCode || '28001',
              totalPacklinkCandidates: allNormalized.length
            };
          }
        }
      }
    } catch (plErr: any) {
      console.warn('[Packlink API] Usando tarifas zonales de respaldo:', plErr?.message);
    }
  }

  let quotes: ServerShippingQuote[] = [];
  if (isoCountry === 'ES') {
    const prefix = cleanPostal.slice(0, 2);
    if (prefix === '35' || prefix === '38' || prefix === '51' || prefix === '52') {
      quotes = [
        {
