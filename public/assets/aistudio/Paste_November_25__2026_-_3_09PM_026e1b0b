  BE: 'BE',
  BELGIUM: 'BE',
  BELGICA: 'BE',
  'BÉLGICA': 'BE',
  NL: 'NL',
  NETHERLANDS: 'NL',
  HOLANDA: 'NL',
  'PAISES BAJOS': 'NL',
  'PAÍSES BAJOS': 'NL',
  IE: 'IE',
